<ResourceDictionary x:Class="ClipboardManager.Views.LightGlass"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light "liquid glass" palette. Keep every key in sync with LiquidGlass.xaml. -->
    <Color x:Key="AccentColor">#167D6B</Color>
    <Color x:Key="AccentGlowColor">#99167D6B</Color>
    <Color x:Key="CardShadowColor">#243D43</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#DDF2EC" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1D2930" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#53636A" />
    <SolidColorBrush x:Key="BorderBrush" Color="#552C3A40" />
    <SolidColorBrush x:Key="GlassStrokeBrush" Color="#70FFFFFF" />
    <SolidColorBrush x:Key="GlassShadowBrush" Color="#27182A31" />
    <SolidColorBrush x:Key="HoverSurfaceBrush" Color="#E8E4F1EE" />
    <SolidColorBrush x:Key="PressedSurfaceBrush" Color="#D0D7E9E3" />
    <SolidColorBrush x:Key="PinnedGlassBrush" Color="#DDE8F3EE" />
    <SolidColorBrush x:Key="PinnedBorderBrush" Color="#99167D6B" />
    <SolidColorBrush x:Key="ToolTipBackgroundBrush" Color="#F7FFFFFF" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#661D2930" />
    <SolidColorBrush x:Key="ControlShadowBrush" Color="#1A213439" />
    <SolidColorBrush x:Key="ControlHoverBorderBrush" Color="#B8FFFFFF" />
    <SolidColorBrush x:Key="InputShadowBrush" Color="#1C04232A" />
    <SolidColorBrush x:Key="InputFocusBackgroundBrush" Color="#EFFFFFFF" />
    <SolidColorBrush x:Key="InputFocusBorderBrush" Color="#167D6B" />
    <SolidColorBrush x:Key="TextSelectionBrush" Color="#80107868" />
    <SolidColorBrush x:Key="PrimaryBorderBrush" Color="#7FFFFFFF" />
    <SolidColorBrush x:Key="PrimaryForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CaptionBarBrush" Color="#40FFFFFF" />
    <SolidColorBrush x:Key="CaptionForegroundBrush" Color="#3A4650" />
    <SolidColorBrush x:Key="CaptionHoverBrush" Color="#552C3A40" />
    <SolidColorBrush x:Key="CaptionPressedBrush" Color="#1F1D2930" />
    <SolidColorBrush x:Key="CaptionDividerBrush" Color="#33707C7D" />
    <SolidColorBrush x:Key="CaptionSeparatorBrush" Color="#26707C7D" />
    <SolidColorBrush x:Key="CloseHoverBrush" Color="#C42B2B" />
    <SolidColorBrush x:Key="ClosePressedBrush" Color="#A52626" />
    <SolidColorBrush x:Key="FilterPanelBrush" Color="#66FFFFFF" />
    <SolidColorBrush x:Key="FilterPanelBorderBrush" Color="#4D1D2930" />
    <SolidColorBrush x:Key="FilterHoverBrush" Color="#2E26363B" />
    <SolidColorBrush x:Key="FilterSelectedBorderBrush" Color="#80107868" />
    <SolidColorBrush x:Key="FilterSelectedForegroundBrush" Color="#0B5145" />
    <SolidColorBrush x:Key="NoticeBackgroundBrush" Color="#FFF2D9" />
    <SolidColorBrush x:Key="NoticeBorderBrush" Color="#F0D69E" />
    <SolidColorBrush x:Key="NoticeTextBrush" Color="#704E13" />
    <SolidColorBrush x:Key="RecordShadowBrush" Color="#1A1D2930" />
    <SolidColorBrush x:Key="RecordHoverBrush" Color="#DDEAEFEB" />
    <SolidColorBrush x:Key="RecordHoverBorderBrush" Color="#66167D6B" />
    <SolidColorBrush x:Key="RecordSelectedBorderBrush" Color="#99167D6B" />
    <SolidColorBrush x:Key="TagBackgroundBrush" Color="#1F167D6B" />
    <SolidColorBrush x:Key="TagBorderBrush" Color="#40167D6B" />
    <SolidColorBrush x:Key="TagImageBackgroundBrush" Color="#26A45A22" />
    <SolidColorBrush x:Key="TagTextBrush" Color="#4C5A60" />
    <SolidColorBrush x:Key="ActionPanelBrush" Color="#4DFFFFFF" />
    <SolidColorBrush x:Key="PinActiveBackgroundBrush" Color="#33167D6B" />
    <SolidColorBrush x:Key="EmptyIconBackgroundBrush" Color="#33167D6B" />
    <SolidColorBrush x:Key="EmptyIconBorderBrush" Color="#66167D6B" />
    <SolidColorBrush x:Key="StatusBarBrush" Color="#8CFFFFFF" />
    <SolidColorBrush x:Key="ImageWellBackgroundBrush" Color="#E9ECEF" />
    <SolidColorBrush x:Key="ImageWellBorderBrush" Color="#552C3A40" />
    <SolidColorBrush x:Key="ReadOnlyBackgroundBrush" Color="#ECEFF2" />
    <SolidColorBrush x:Key="ErrorTextBrush" Color="#A12635" />
    <SolidColorBrush x:Key="DangerTextBrush" Color="#B3393F" />
    <SolidColorBrush x:Key="OverlayScrimBrush" Color="#381B2930" />
    <LinearGradientBrush x:Key="OverlayGlassBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F7FFFFFF" Offset="0" />
        <GradientStop Color="#E8F4F7F8" Offset="0.45" />
        <GradientStop Color="#DCE9F0F2" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="OverlayEdgeBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFFFF" Offset="0" />
        <GradientStop Color="#D9FFFFFF" Offset="0.55" />
        <GradientStop Color="#8C9CBFC4" Offset="1" />
    </LinearGradientBrush>
    <DropShadowEffect x:Key="OverlayShadowEffect" Color="#3D334047" BlurRadius="32" ShadowDepth="8" Direction="270" Opacity="0.28" />

    <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F2F3FAF8" Offset="0" />
        <GradientStop Color="#F2F5F9FA" Offset="0.38" />
        <GradientStop Color="#F2F2F6FA" Offset="0.72" />
        <GradientStop Color="#F2F7F4FA" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SurfaceBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#CCFFFFFF" Offset="0" />
        <GradientStop Color="#B3FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RaisedSurfaceBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F2FFFFFF" Offset="0" />
        <GradientStop Color="#E6FFFFFF" Offset="0.5" />
        <GradientStop Color="#D9F7FCFB" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SoftSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#D9FFFFFF" Offset="0" />
        <GradientStop Color="#A6FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassSheenBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E6FFFFFF" Offset="0" />
        <GradientStop Color="#66FFFFFF" Offset="0.38" />
        <GradientStop Color="#00FFFFFF" Offset="0.72" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassEdgeBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F2FFFFFF" Offset="0" />
        <GradientStop Color="#B8FFFFFF" Offset="0.38" />
        <GradientStop Color="#66FFFFFF" Offset="0.72" />
        <GradientStop Color="#8C167D6B" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SelectionBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#BFD4EEE8" Offset="0" />
        <GradientStop Color="#A6C6E8E0" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PrimaryBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#228671" Offset="0" />
        <GradientStop Color="#146F61" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PrimaryHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2A9A83" Offset="0" />
        <GradientStop Color="#177A6A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PrimaryPressedBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1D7563" Offset="0" />
        <GradientStop Color="#0F5F54" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="EmptyPanelBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#CCFFFFFF" Offset="0" />
        <GradientStop Color="#99FFFFFF" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
