<Grid x:Class="ClipboardManager.Views.MainView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:ClipboardManager.Controls"
      xmlns:local="clr-namespace:ClipboardManager.Views"
      Background="Transparent" UseLayoutRounding="True" SnapsToDevicePixels="True"
      TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Grid.Resources>
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RecordCopySurface" TargetType="Button" BasedOn="{StaticResource CopySurface}">
            <Setter Property="Padding" Value="6,0,4,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="300" />
            <Setter Property="ToolTipService.ShowDuration" Value="60000" />
            <EventSetter Event="ToolTipOpening" Handler="OnHoverPreviewToolTipOpening" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnRecordDragMouseLeftButtonDown" />
            <EventSetter Event="PreviewMouseMove" Handler="OnRecordDragMouseMove" />
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnRecordDragMouseLeftButtonUp" />
        </Style>



        <sys:Double x:Key="HistoryRowHeight" xmlns:sys="clr-namespace:System;assembly=mscorlib">38</sys:Double>
        <DropShadowEffect x:Key="HoverPreviewShadow" Color="#42505A" BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.30" />
        <Style x:Key="HoverPreviewToolTip" TargetType="ToolTip" BasedOn="{StaticResource {x:Type ToolTip}}">
            <Setter Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="Effect" Value="{StaticResource HoverPreviewShadow}" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="Background" Value="{DynamicResource HoverPreviewBackgroundBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding ContentStringFormat}" RecognizesAccessKey="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="HoverPreviewText">
            <StackPanel MaxWidth="400">
                <TextBlock Text="文本预览" FontSize="10.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}" Margin="1,0,0,7" />
                <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock Text="{Binding HoverText}" TextWrapping="Wrap" FontSize="12.5" LineHeight="19"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </ScrollViewer>
                <TextBlock Text="{Binding ContentInfo}" Margin="1,7,0,0" FontSize="10.5"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="HoverPreviewImage">
            <StackPanel MaxWidth="400">
                <Border Background="{DynamicResource ImageWellBackgroundBrush}"
                        BorderBrush="{DynamicResource ImageWellBorderBrush}"
                        BorderThickness="1" CornerRadius="6" ClipToBounds="True" Padding="1" Margin="0,0,0,7">
                    <controls:AsyncThumbnail FilePath="{Binding ImagePath}" Stretch="Uniform"
                                             MaxWidth="{Binding PreviewImageWidth}" MaxHeight="{Binding PreviewImageHeight}"
                                             HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <TextBlock Text="{Binding ContentInfo}" HorizontalAlignment="Center" FontSize="10.5"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
        </DataTemplate>

    </Grid.Resources>

    <!-- Capsule: the preview copies the newest record; the chevron opens history. -->
    <Grid x:Name="Capsule" Width="240" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" AutomationProperties.Name="剪贴板小组件">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="32" />
        </Grid.ColumnDefinitions>
        <Border x:Name="CapsuleDragHandle" Grid.Column="0" Background="Transparent" Cursor="SizeAll"
                ToolTip="拖动移动小组件" AutomationProperties.Name="拖动移动小组件">
            <Ellipse Style="{StaticResource StatusDot}" HorizontalAlignment="Center" />
        </Border>
        <Button x:Name="LatestCopyButton" Grid.Column="1" Command="{Binding LatestRecord.CopyCommand}"
                Style="{StaticResource RecordCopySurface}" Padding="2,0"
                AutomationProperties.Name="复制最新记录" IsEnabled="{Binding HasRecords}" Focusable="True" IsTabStop="True">
            <Button.ToolTip>
                <ToolTip Placement="Custom" Style="{StaticResource HoverPreviewToolTip}" Padding="11,9,11,10" Content="{Binding LatestRecord}" ContentTemplateSelector="{x:Static local:MainView.RecordHoverSelector}" ContentTemplate="{x:Null}" />
            </Button.ToolTip>
            <TextBlock Text="{Binding CapsuleText}" FontSize="12.5" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Foreground="{DynamicResource TextPrimaryBrush}" />
        </Button>
        <Border Grid.Column="2" Background="{DynamicResource TagBackgroundBrush}" BorderBrush="{DynamicResource TagBorderBrush}"
                BorderThickness="1" CornerRadius="9" Padding="7,0" Height="18" Margin="5,0,5,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding RecordCount}" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"
                       Foreground="{DynamicResource FilterSelectedForegroundBrush}" />
        </Border>
        <ToggleButton x:Name="HistoryToggleButton" Grid.Column="3" Style="{StaticResource PinCaptionButton}"
                      IsThreeState="False" ToolTip="显示历史记录" AutomationProperties.Name="显示历史记录"
                      HorizontalAlignment="Right" Margin="0,0,6,0">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="11" />
        </ToggleButton>
    </Grid>

    <Popup x:Name="HistoryPopup" PlacementTarget="{Binding ElementName=Capsule}" Placement="Bottom"
           AllowsTransparency="True" StaysOpen="True" PopupAnimation="Fade" Focusable="False">
        <Border x:Name="HistoryPopupBorder" Width="300" MaxHeight="360" Padding="0"
                Background="{DynamicResource PopupBackgroundBrush}" BorderBrush="{DynamicResource GlassEdgeBrush}"
                BorderThickness="1" CornerRadius="12" RenderOptions.ClearTypeHint="Enabled">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Border x:Name="HistoryHeader" Padding="12,9" BorderBrush="{DynamicResource GlassEdgeBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="历史记录" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="最近复制" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding RecordCount}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="4,0,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
                <ListBox x:Name="HistoryRecords" Grid.Row="1" ItemsSource="{Binding HistoryRecords}"
                         MaxHeight="280" Background="Transparent" BorderThickness="0" Padding="5,4"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True"
                         AutomationProperties.Name="剪贴板历史记录下拉列表">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Height" Value="{StaticResource HistoryRowHeight}" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,1" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="HistoryRow" Background="Transparent" CornerRadius="6">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HistoryRow" Property="Background" Value="{DynamicResource RecordHoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="HistoryRow" Property="Background" Value="{DynamicResource SelectionBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding CopyCommand}" Style="{StaticResource RecordCopySurface}"
                                    Padding="7,5" AutomationProperties.Name="复制此历史记录">
                                <Button.ToolTip>
                                    <ToolTip Placement="Custom" Style="{StaticResource HoverPreviewToolTip}" Padding="11,9,11,10" Content="{Binding}" ContentTemplateSelector="{x:Static local:MainView.RecordHoverSelector}" ContentTemplate="{x:Null}" />
                                </Button.ToolTip>
                                <Grid Height="26">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding PositionLabel}" Width="18" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding SingleLine}" FontSize="12" VerticalAlignment="Center"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Grid.Column="2" Text="{Binding ShortTimeLabel}" FontSize="10" Margin="8,0,1,0"
                                               VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="1" Text="暂无剪贴板记录" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasRecords}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Border x:Name="HistoryFooter" Grid.Row="2" BorderBrush="{DynamicResource GlassEdgeBrush}" BorderThickness="0,1,0,0" Padding="8,5">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Button x:Name="SettingsButton" Command="{Binding SettingsCommand}" Content="设置" HorizontalAlignment="Left"
                                MinHeight="28" Padding="9,3" AutomationProperties.Name="打开设置" />
                        <Button x:Name="MoreButton" Grid.Column="1" Content="更多 ⋯" HorizontalAlignment="Right"
                                MinHeight="28" Padding="9,3" AutomationProperties.Name="更多操作" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Popup>

</Grid>
