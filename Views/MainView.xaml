<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:ClipboardManager.Controls;assembly=ClipboardManager"
      Background="Transparent">
    <Grid.Resources>
        <DataTemplate x:Key="TextContent">
            <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                       LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource TextPrimaryBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="MaxHeight" Value="66" />
                        <Setter Property="LineHeight" Value="21" />
                        <Setter Property="FontSize" Value="13" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="MaxHeight" Value="42" />
                                <Setter Property="LineHeight" Value="19" />
                                <Setter Property="FontSize" Value="12.5" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>
        <DataTemplate x:Key="ImageContent">
            <Border Background="{DynamicResource ImageWellBackgroundBrush}" BorderBrush="{DynamicResource ImageWellBorderBrush}" BorderThickness="1" CornerRadius="7"
                    Height="{Binding DataContext.ThumbnailHeight, RelativeSource={RelativeSource AncestorType=Window}}">
                <Grid Margin="5">
                    <controls:AsyncThumbnail x:Name="Thumbnail" FilePath="{Binding ImagePath}" Stretch="Uniform"
                                             RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="{Binding StatusText, ElementName=Thumbnail}" Style="{StaticResource SecondaryText}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>
        <Style x:Key="GlassToolButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Background" Value="{DynamicResource SoftSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GlassEdgeBrush}" />
        </Style>
        <Style x:Key="FilterItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="FilterChrome" Background="Transparent" BorderBrush="Transparent"
                                    BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FilterChrome" Property="Background" Value="{DynamicResource FilterHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="FilterChrome" Property="Background" Value="{DynamicResource SelectionBrush}" />
                                <Setter TargetName="FilterChrome" Property="BorderBrush" Value="{DynamicResource FilterSelectedBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource FilterSelectedForegroundBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FilterChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RecordAction" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="27" />
            <Setter Property="Height" Value="27" />
            <Setter Property="MinHeight" Value="27" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
        </Style>
        <Style x:Key="RecordCopySurface" TargetType="Button" BasedOn="{StaticResource CopySurface}">
            <Setter Property="Padding" Value="12,10,64,11" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Padding" Value="10,8,58,9" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EmptyGlassPanel" TargetType="Border" BasedOn="{StaticResource GlassCard}">
            <Setter Property="Width" Value="252" />
            <Setter Property="Padding" Value="22,21" />
            <Setter Property="Background" Value="{DynamicResource EmptyPanelBrush}" />
        </Style>
    </Grid.Resources>

    <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>


    <Grid Grid.Row="0" Margin="12,10,12,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Margin="4,0,8,0" VerticalAlignment="Center" Orientation="Horizontal">
            <TextBlock Text="历史记录" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource GlassToolButton}" Command="{Binding UpdateCommand}" ToolTip="检查应用更新"
                    AutomationProperties.Name="检查应用更新" Margin="0,0,4,0">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE895;" />
            </Button>
            <Button Style="{StaticResource GlassToolButton}" Command="{Binding ClearCommand}" ToolTip="清空全部历史记录"
                    AutomationProperties.Name="清空全部历史记录" Margin="0,0,4,0">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" />
            </Button>
            <Button Style="{StaticResource GlassToolButton}" Command="{Binding SettingsCommand}" ToolTip="设置" AutomationProperties.Name="设置">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" />
            </Button>
        </StackPanel>
    </Grid>

    <Grid Grid.Row="1" Margin="13,10,13,0">
        <TextBox x:Name="SearchBox" Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.Name="搜索文本内容" MinHeight="40">
            <TextBox.Style>
                <Style TargetType="TextBox" BasedOn="{StaticResource GlassTextBox}">
                    <Setter Property="Padding" Value="31,9,31,9" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCompact}" Value="True">
                            <Setter Property="Padding" Value="31,7,31,7" />
                            <Setter Property="MinHeight" Value="36" />
                            <Setter Property="FontSize" Value="13" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBox.Style>
        </TextBox>
        <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="14" HorizontalAlignment="Left" Margin="11,0,0,0"
                   Foreground="{DynamicResource TextSecondaryBrush}" IsHitTestVisible="False" />
        <TextBlock Text="搜索复制过的文字" Foreground="{DynamicResource TextSecondaryBrush}" Margin="34,0,0,0" VerticalAlignment="Center"
                   IsHitTestVisible="False" FontSize="12">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasSearch}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <Button Style="{StaticResource IconButton}" Command="{Binding ClearSearchCommand}" ToolTip="清除搜索"
                AutomationProperties.Name="清除搜索" HorizontalAlignment="Right" Margin="0,0,4,0" Width="27" Height="27"
                MinHeight="27" BorderThickness="0" Background="Transparent"
                Visibility="{Binding HasSearch, Converter={StaticResource BoolVisibility}}">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="11" />
        </Button>
    </Grid>

    <Grid Grid.Row="2" Margin="13,8,13,8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Border Background="{DynamicResource FilterPanelBrush}" BorderBrush="{DynamicResource FilterPanelBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="3" HorizontalAlignment="Left">
            <ListBox BorderThickness="0" Background="Transparent" SelectedIndex="{Binding FilterIndex, Mode=TwoWay}"
                     ItemContainerStyle="{StaticResource FilterItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="内容类型筛选">
                <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBoxItem><TextBlock Text="{Binding AllLabel}" /></ListBoxItem>
                <ListBoxItem><TextBlock Text="{Binding TextLabel}" /></ListBoxItem>
                <ListBoxItem><TextBlock Text="{Binding ImageLabel}" /></ListBoxItem>
            </ListBox>
        </Border>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,1,0">
            <Ellipse Width="5" Height="5" Fill="{DynamicResource AccentBrush}" Margin="0,0,5,0" />
            <TextBlock Text="最新在前" Style="{StaticResource SecondaryText}" FontSize="11" />
        </StackPanel>
    </Grid>

    <Border Grid.Row="3" Margin="12,0,12,9" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource GlassEdgeBrush}"
            BorderThickness="0" CornerRadius="14">
        <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="4" Direction="270" Opacity="0.25" /></Border.Effect>
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border Background="{DynamicResource GlassSheenBrush}" CornerRadius="13" Margin="1,1,1,0" IsHitTestVisible="False" />
            <Border Background="{DynamicResource NoticeBackgroundBrush}" BorderBrush="{DynamicResource NoticeBorderBrush}" BorderThickness="1" CornerRadius="7" Margin="10,9,10,0"
                    Visibility="{Binding HasNotice, Converter={StaticResource BoolVisibility}}">
                <Grid Margin="8,5">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" Foreground="{DynamicResource NoticeTextBrush}" VerticalAlignment="Center" Margin="0,0,5,0"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Notice}" MaxHeight="72" FontSize="12" />
                    <Button Grid.Column="1" Style="{StaticResource RecordAction}" Command="{Binding DismissNoticeCommand}"
                            Background="Transparent" BorderThickness="0" ToolTip="关闭提示" AutomationProperties.Name="关闭提示">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="11" />
                    </Button>
                </Grid>
            </Border>
            <Grid Grid.Row="1">
                <ListBox x:Name="HistoryList" ItemsSource="{Binding VisibleRecords}" SelectedItem="{Binding SelectedRecord, Mode=TwoWay}"
                         SelectionMode="Single" Background="Transparent" BorderThickness="0" KeyboardNavigation.TabNavigation="Once"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True" HorizontalContentAlignment="Stretch"
                         AutomationProperties.Name="剪贴板历史记录">
                    <ListBox.Style>
                        <Style TargetType="ListBox">
                            <Setter Property="Padding" Value="9,9,9,6" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Padding" Value="7,7,7,4" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Style>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="MaxWidth" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollContentPresenter}}" />
                            <Setter Property="Margin" Value="0,0,0,6" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Grid>
                                            <Border x:Name="RecordShadow" Background="{DynamicResource RecordShadowBrush}" CornerRadius="22" Margin="1,2,1,0" IsHitTestVisible="False" />
                                            <Border x:Name="RecordChrome" Background="{DynamicResource RaisedSurfaceBrush}" BorderBrush="{DynamicResource GlassEdgeBrush}"
                                                    BorderThickness="1" CornerRadius="22">
                                                <Grid ClipToBounds="True">
                                                    <Border Background="{DynamicResource GlassSheenBrush}" CornerRadius="21" Margin="1" IsHitTestVisible="False" />
                                                    <ContentPresenter HorizontalAlignment="Stretch" />
                                                </Grid>
                                            </Border>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="RecordChrome" Property="Background" Value="{DynamicResource RecordHoverBrush}" />
                                                <Setter TargetName="RecordChrome" Property="BorderBrush" Value="{DynamicResource RecordHoverBorderBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="RecordChrome" Property="Background" Value="{DynamicResource SelectionBrush}" />
                                                <Setter TargetName="RecordChrome" Property="BorderBrush" Value="{DynamicResource RecordSelectedBorderBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="RecordChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Button Command="{Binding CopyCommand}" Style="{StaticResource RecordCopySurface}" ToolTip="{Binding CopyToolTip}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border CornerRadius="4" Padding="5,1" BorderThickness="1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource TagBackgroundBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource TagBorderBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsImage}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource TagImageBackgroundBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding TypeLabel}" FontSize="10.5" Foreground="{DynamicResource TagTextBrush}" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Style="{StaticResource Icon}" Text="&#xE718;" FontSize="10"
                                                       Foreground="{DynamicResource AccentBrush}" Margin="5,0,0,0"
                                                       Visibility="{Binding IsPinned, Converter={StaticResource BoolVisibility}}" ToolTip="已固定" />
                                            <TextBlock Grid.Column="2" Text="{Binding ShortTimeLabel}" Style="{StaticResource SecondaryText}" FontSize="10.5"
                                                       VerticalAlignment="Center" ToolTip="{Binding FullTime}" Margin="6,0,0,0" />
                                            <TextBlock Grid.Column="3" Text="{Binding ContentInfo}" Style="{StaticResource SecondaryText}" FontSize="10.5"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding ContentInfo}"
                                                       Margin="6,0,2,0" HorizontalAlignment="Stretch" TextAlignment="Right" />
                                        </Grid>
                                        <ContentControl Grid.Row="1" Content="{Binding}" HorizontalContentAlignment="Stretch"
                                                        VerticalContentAlignment="Top" MinHeight="42">
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource TextContent}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsImage}" Value="True">
                                                            <Setter Property="ContentTemplate" Value="{StaticResource ImageContent}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                        </ContentControl>
                                    </Grid>
                                </Button>
                                <Border Background="{DynamicResource ActionPanelBrush}" BorderBrush="{DynamicResource GlassEdgeBrush}" BorderThickness="1" CornerRadius="8"
                                        Width="34" Height="108" Margin="0,5,5,5" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                                    <UniformGrid Rows="4" Columns="1">
                                        <Button Command="{Binding CopyCommand}" Style="{StaticResource RecordAction}" ToolTip="{Binding CopyToolTip}"
                                                AutomationProperties.Name="复制记录" Foreground="{DynamicResource AccentBrush}">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="13" />
                                        </Button>
                                        <Button Command="{Binding PinCommand}" ToolTip="{Binding PinToolTip}" AutomationProperties.Name="{Binding PinToolTip}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource RecordAction}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource PinActiveBackgroundBrush}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE718;" FontSize="12" />
                                        </Button>
                                        <Button Command="{Binding DetailsCommand}" Style="{StaticResource RecordAction}" ToolTip="查看完整内容"
                                                AutomationProperties.Name="查看完整内容">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="13" />
                                        </Button>
                                        <Button Command="{Binding DeleteCommand}" Style="{StaticResource RecordAction}" ToolTip="删除记录"
                                                AutomationProperties.Name="删除记录" Foreground="{DynamicResource DangerTextBrush}">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="12" />
                                        </Button>
                                    </UniformGrid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,8"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}">
                    <Border Style="{StaticResource EmptyGlassPanel}">
                        <StackPanel>
                            <Border Width="48" Height="48" CornerRadius="16" HorizontalAlignment="Center"
                                    Background="{DynamicResource EmptyIconBackgroundBrush}" BorderBrush="{DynamicResource EmptyIconBorderBrush}" BorderThickness="1">
                                <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="15" ShadowDepth="3" Opacity="0.2" /></Border.Effect>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE77F;" FontSize="21" Foreground="{DynamicResource AccentBrush}" />
                            </Border>
                            <TextBlock Text="{Binding EmptyTitle}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0"
                                       TextWrapping="NoWrap" />
                            <TextBlock Text="{Binding EmptySubtitle}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" Margin="0,5,0,0"
                                       TextWrapping="Wrap" TextAlignment="Center" LineHeight="18" />
                            <Button Content="重新加载" Command="{Binding RetryCommand}" HorizontalAlignment="Center" Margin="0,14,0,0" MinWidth="92"
                                    Visibility="{Binding CanRetry, Converter={StaticResource BoolVisibility}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolVisibility}}">
                    <ProgressBar IsIndeterminate="True" Width="150" Height="3" Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="正在加载历史记录…" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,13,0,0" FontSize="12" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>

    <Border Grid.Row="4" Margin="13,0,13,11" Background="{DynamicResource StatusBarBrush}" BorderBrush="{DynamicResource GlassEdgeBrush}" BorderThickness="1"
            CornerRadius="10" Padding="10,7">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Margin="0,0,6,0">
                    <Ellipse.Effect><DropShadowEffect Color="{DynamicResource AccentGlowColor}" BlurRadius="5" ShadowDepth="0" Opacity="0.45" /></Ellipse.Effect>
                </Ellipse>
                <TextBlock Text="{Binding MonitorStatus}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                <Button Style="{StaticResource RecordAction}" Command="{Binding PauseCommand}" ToolTip="{Binding PauseToolTip}"
                        AutomationProperties.Name="{Binding PauseToolTip}" Background="Transparent" BorderThickness="0" Margin="4,0,0,0">
                    <TextBlock FontSize="11">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                <Setter Property="Text" Value="&#xE769;" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPaused}" Value="True"><Setter Property="Text" Value="&#xE768;" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding CountLabel}" Style="{StaticResource SecondaryText}" FontSize="10.5"
                       VerticalAlignment="Center" TextAlignment="Right" TextTrimming="CharacterEllipsis" ToolTip="{Binding CountLabel}" />
            <TextBlock Grid.ColumnSpan="2" Text="{Binding Status}" Style="{StaticResource SecondaryText}" FontSize="10.5"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" Margin="0,0,0,-1"
                       ToolTip="{Binding Status}" Visibility="Collapsed" />
        </Grid>
    </Border>
</Grid>
