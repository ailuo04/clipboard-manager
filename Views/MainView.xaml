<Grid x:Class="ClipboardManager.Views.MainView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:ClipboardManager.Controls"
      xmlns:local="clr-namespace:ClipboardManager.Views"
      Background="Transparent">
    <Grid.Resources>
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FilterItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="FilterChrome" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FilterChrome" Property="Background" Value="{DynamicResource FilterHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="FilterChrome" Property="Background" Value="{DynamicResource SelectionBrush}" />
                                <Setter TargetName="FilterChrome" Property="BorderBrush" Value="{DynamicResource FilterSelectedBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource FilterSelectedForegroundBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FilterChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RecordAction" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
        </Style>
        <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style x:Key="RecordCopySurface" TargetType="Button" BasedOn="{StaticResource CopySurface}">
            <Setter Property="Padding" Value="6,0,4,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="300" />
            <Setter Property="ToolTipService.ShowDuration" Value="60000" />
            <EventSetter Event="ToolTipOpening" Handler="OnHoverPreviewToolTipOpening" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnRecordDragMouseLeftButtonDown" />
            <EventSetter Event="PreviewMouseMove" Handler="OnRecordDragMouseMove" />
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnRecordDragMouseLeftButtonUp" />
        </Style>



        <DropShadowEffect x:Key="HoverPreviewShadow" Color="#42505A" BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.30" />
        <Style x:Key="HoverPreviewToolTip" TargetType="ToolTip" BasedOn="{StaticResource {x:Type ToolTip}}">
            <Setter Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="Effect" Value="{StaticResource HoverPreviewShadow}" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="Background" Value="{DynamicResource HoverPreviewBackgroundBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding ContentStringFormat}" RecognizesAccessKey="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="HoverPreviewText">
            <StackPanel MaxWidth="400">
                <TextBlock Text="文本预览" FontSize="10.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}" Margin="1,0,0,7" />
                <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock Text="{Binding HoverText}" TextWrapping="Wrap" FontSize="12.5" LineHeight="19"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </ScrollViewer>
                <TextBlock Text="{Binding ContentInfo}" Margin="1,7,0,0" FontSize="10.5"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="HoverPreviewImage">
            <StackPanel MaxWidth="400">
                <Border Background="{DynamicResource ImageWellBackgroundBrush}"
                        BorderBrush="{DynamicResource ImageWellBorderBrush}"
                        BorderThickness="1" CornerRadius="6" ClipToBounds="True" Padding="1" Margin="0,0,0,7">
                    <controls:AsyncThumbnail FilePath="{Binding ImagePath}" Stretch="Uniform"
                                             MaxWidth="{Binding PreviewImageWidth}" MaxHeight="{Binding PreviewImageHeight}"
                                             HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <TextBlock Text="{Binding ContentInfo}" HorizontalAlignment="Center" FontSize="10.5"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
        </DataTemplate>

    </Grid.Resources>

    <!-- Collapsed capsule: the preview copies the newest record; the chevron opens history. -->
    <Grid x:Name="Capsule" Width="240" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" AutomationProperties.Name="剪贴板小组件" Visibility="{Binding IsWidgetCollapsed, Converter={StaticResource BoolVisibility}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="32" />
        </Grid.ColumnDefinitions>
        <Border x:Name="CapsuleDragHandle" Grid.Column="0" Background="Transparent" Cursor="SizeAll"
                ToolTip="拖动移动小组件" AutomationProperties.Name="拖动移动小组件">
            <Ellipse Style="{StaticResource StatusDot}" HorizontalAlignment="Center" />
        </Border>
        <Button x:Name="LatestCopyButton" Grid.Column="1" Command="{Binding LatestRecord.CopyCommand}"
                Style="{StaticResource RecordCopySurface}" Padding="2,0"
                AutomationProperties.Name="复制最新记录" IsEnabled="{Binding HasRecords}" Focusable="True" IsTabStop="True">
            <Button.ToolTip>
                <ToolTip Placement="Custom" Style="{StaticResource HoverPreviewToolTip}" Padding="11,9,11,10" Content="{Binding LatestRecord}" ContentTemplateSelector="{x:Static local:MainView.RecordHoverSelector}" ContentTemplate="{x:Null}" />
            </Button.ToolTip>
            <TextBlock Text="{Binding CapsuleText}" FontSize="12.5" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Foreground="{DynamicResource TextPrimaryBrush}" />
        </Button>
        <Border Grid.Column="2" Background="{DynamicResource TagBackgroundBrush}" BorderBrush="{DynamicResource TagBorderBrush}"
                BorderThickness="1" CornerRadius="9" Padding="7,0" Height="18" Margin="5,0,5,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding RecordCount}" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"
                       Foreground="{DynamicResource FilterSelectedForegroundBrush}" />
        </Border>
        <ToggleButton x:Name="HistoryToggleButton" Grid.Column="3" Style="{StaticResource PinCaptionButton}"
                      IsThreeState="False" ToolTip="显示历史记录" AutomationProperties.Name="显示历史记录"
                      HorizontalAlignment="Right" Margin="0,0,6,0">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="11" />
        </ToggleButton>
    </Grid>

    <Popup x:Name="HistoryPopup" PlacementTarget="{Binding ElementName=Capsule}" Placement="Bottom"
           AllowsTransparency="True" StaysOpen="True" PopupAnimation="Fade" Focusable="False">
        <Border x:Name="HistoryPopupBorder" Width="300" MaxHeight="360" Padding="0"
                Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource GlassEdgeBrush}"
                BorderThickness="1" CornerRadius="12" Effect="{DynamicResource OverlayShadowEffect}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Border Padding="12,9" BorderBrush="{DynamicResource GlassEdgeBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="历史记录" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="最近复制" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding RecordCount}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="4,0,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
                <ListBox x:Name="HistoryRecords" Grid.Row="1" ItemsSource="{Binding HistoryRecords}"
                         MaxHeight="280" Background="Transparent" BorderThickness="0" Padding="5,4"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         AutomationProperties.Name="剪贴板历史记录下拉列表">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,1" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="HistoryRow" Background="Transparent" CornerRadius="6">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HistoryRow" Property="Background" Value="{DynamicResource RecordHoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="HistoryRow" Property="Background" Value="{DynamicResource SelectionBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding CopyCommand}" Style="{StaticResource RecordCopySurface}"
                                    Padding="7,5" AutomationProperties.Name="复制此历史记录">
                                <Button.ToolTip>
                                    <ToolTip Placement="Custom" Style="{StaticResource HoverPreviewToolTip}" Padding="11,9,11,10" Content="{Binding}" ContentTemplateSelector="{x:Static local:MainView.RecordHoverSelector}" ContentTemplate="{x:Null}" />
                                </Button.ToolTip>
                                <Grid Height="26">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding PositionLabel}" Width="18" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding SingleLine}" FontSize="12" VerticalAlignment="Center"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Grid.Column="2" Text="{Binding ShortTimeLabel}" FontSize="10" Margin="8,0,1,0"
                                               VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="1" Text="暂无剪贴板记录" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasRecords}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Border Grid.Row="2" BorderBrush="{DynamicResource GlassEdgeBrush}" BorderThickness="0,1,0,0" Padding="8,5">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Button x:Name="SettingsButton" Command="{Binding SettingsCommand}" Content="设置" HorizontalAlignment="Left"
                                MinHeight="28" Padding="9,3" AutomationProperties.Name="打开设置" />
                        <Button x:Name="MoreButton" Grid.Column="1" Content="更多 ⋯" HorizontalAlignment="Right"
                                MinHeight="28" Padding="9,3" AutomationProperties.Name="更多操作" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Popup>

    <!-- Expanded: the compact panel. -->
    <Grid x:Name="Panel">
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsWidgetCollapsed}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <Grid Margin="4,7,6,7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border x:Name="DragHandle" Background="Transparent" Width="26" Cursor="SizeAll" ToolTip="{Binding MonitorStatus}"
                    AutomationProperties.Name="拖动移动小组件">
                <Ellipse Style="{StaticResource StatusDot}" HorizontalAlignment="Center" />
            </Border>
            <Grid Grid.Column="1">
                <TextBox x:Name="SearchBox" Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource GlassTextBox}" AutomationProperties.Name="搜索文本内容"
                         MinHeight="26" Height="26" Padding="24,3,22,3" FontSize="12"
                         Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource GlassEdgeBrush}" />
                <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="12" HorizontalAlignment="Left" Margin="8,0,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}" IsHitTestVisible="False" />
                <TextBlock Text="搜索复制过的文字" Foreground="{DynamicResource TextSecondaryBrush}" Margin="26,0,0,0" VerticalAlignment="Center"
                           IsHitTestVisible="False" FontSize="11.5">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSearch}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button Style="{StaticResource RecordAction}" Command="{Binding ClearSearchCommand}" ToolTip="清除搜索"
                        AutomationProperties.Name="清除搜索" HorizontalAlignment="Right" Margin="0,0,2,0"
                        Visibility="{Binding HasSearch, Converter={StaticResource BoolVisibility}}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="10" />
                </Button>
            </Grid>
            <ToggleButton Grid.Column="2" Style="{StaticResource PinCaptionButton}" Margin="4,0,0,0" IsThreeState="False"
                          IsChecked="{Binding IsAlwaysOnTop, Mode=OneWay}" Command="{Binding ToggleAlwaysOnTopCommand}"
                          ToolTip="{Binding AlwaysOnTopToolTip}" AutomationProperties.Name="{Binding AlwaysOnTopToolTip}">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE718;" FontSize="12" />
            </ToggleButton>
            <Button x:Name="MenuButton" Grid.Column="3" Style="{StaticResource HeaderButton}" ToolTip="菜单" AutomationProperties.Name="菜单">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE700;" FontSize="13" />
            </Button>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource NoticeBackgroundBrush}" BorderBrush="{DynamicResource NoticeBorderBrush}" BorderThickness="1"
                CornerRadius="6" Margin="6,0,6,4" Visibility="{Binding HasNotice, Converter={StaticResource BoolVisibility}}">
            <Grid Margin="7,3,2,3">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" Foreground="{DynamicResource NoticeTextBrush}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Notice}" MaxHeight="48" FontSize="11" />
                <Button Grid.Column="1" Style="{StaticResource RecordAction}" Command="{Binding DismissNoticeCommand}"
                        ToolTip="关闭提示" AutomationProperties.Name="关闭提示" VerticalAlignment="Top">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="10" />
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <ListBox x:Name="HistoryList" ItemsSource="{Binding VisibleRecords}" SelectedItem="{Binding SelectedRecord, Mode=TwoWay}"
                     SelectionMode="Single" Background="Transparent" BorderThickness="0" Padding="5,0,3,0"
                     KeyboardNavigation.TabNavigation="Once"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True" HorizontalContentAlignment="Stretch"
                     AutomationProperties.Name="剪贴板历史记录">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="MaxWidth" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollContentPresenter}}" />
                        <Setter Property="Margin" Value="0,0,0,1" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="RecordChrome" Background="Transparent" BorderBrush="Transparent"
                                            BorderThickness="1" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Stretch" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="RecordChrome" Property="Background" Value="{DynamicResource RecordHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="RecordChrome" Property="Background" Value="{DynamicResource SelectionBrush}" />
                                            <Setter TargetName="RecordChrome" Property="BorderBrush" Value="{DynamicResource RecordSelectedBorderBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="RecordChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="27">
                            <Button Command="{Binding CopyCommand}" Style="{StaticResource RecordCopySurface}">
                                <Button.ToolTip>
                                    <ToolTip Placement="Custom" Style="{StaticResource HoverPreviewToolTip}" Padding="11,9,11,10" Content="{Binding}" ContentTemplateSelector="{x:Static local:MainView.RecordHoverSelector}" ContentTemplate="{x:Null}" />
                                </Button.ToolTip>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="15" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" MinWidth="68" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding PositionLabel}" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Width="26" Height="18" CornerRadius="3" Margin="0,0,6,0" ClipToBounds="True"
                                            Background="{DynamicResource ImageWellBackgroundBrush}" BorderBrush="{DynamicResource ImageWellBorderBrush}" BorderThickness="1"
                                            Visibility="{Binding IsImage, Converter={StaticResource BoolVisibility}}">
                                        <controls:AsyncThumbnail FilePath="{Binding ImagePath}" Stretch="UniformToFill" />
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding SingleLine}" FontSize="12.5" VerticalAlignment="Center"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Grid.Column="3" Style="{StaticResource Icon}" Text="&#xE718;" FontSize="9.5"
                                               Foreground="{DynamicResource AccentBrush}" Margin="5,0,0,0"
                                               Visibility="{Binding IsPinned, Converter={StaticResource BoolVisibility}}" />
                                    <TextBlock Grid.Column="4" Text="{Binding ShortTimeLabel}" FontSize="10" VerticalAlignment="Center"
                                               HorizontalAlignment="Right" Margin="6,0,2,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter Property="Visibility" Value="Hidden" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter Property="Visibility" Value="Hidden" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Button>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Button Command="{Binding PinCommand}" ToolTip="{Binding PinToolTip}" AutomationProperties.Name="{Binding PinToolTip}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource RecordAction}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE718;" FontSize="11" />
                                </Button>
                                <Button Command="{Binding DetailsCommand}" Style="{StaticResource RecordAction}" ToolTip="查看完整内容"
                                        AutomationProperties.Name="查看完整内容">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="11.5" />
                                </Button>
                                <Button Command="{Binding DeleteCommand}" Style="{StaticResource RecordAction}" ToolTip="删除记录"
                                        AutomationProperties.Name="删除记录" Foreground="{DynamicResource DangerTextBrush}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="11" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18,0"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE77F;" FontSize="22" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding EmptyTitle}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,9,0,0" />
                <TextBlock Text="{Binding EmptySubtitle}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0"
                           TextWrapping="Wrap" TextAlignment="Center" />
                <Button Content="重新加载" Command="{Binding RetryCommand}" HorizontalAlignment="Center" Margin="0,11,0,0" MinWidth="84"
                        Visibility="{Binding CanRetry, Converter={StaticResource BoolVisibility}}" />
            </StackPanel>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolVisibility}}">
                <ProgressBar IsIndeterminate="True" Width="130" Height="3" Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Text="正在加载历史记录…" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,11,0,0" FontSize="11.5" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="3" Background="{DynamicResource StatusBarBrush}" BorderBrush="{DynamicResource GlassEdgeBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="5,0,8,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <ListBox BorderThickness="0" Background="Transparent" SelectedIndex="{Binding FilterIndex, Mode=TwoWay}" VerticalAlignment="Center"
                         ItemContainerStyle="{StaticResource FilterItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="内容类型筛选">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBoxItem><TextBlock Text="{Binding AllLabel}" /></ListBoxItem>
                    <ListBoxItem><TextBlock Text="{Binding TextLabel}" /></ListBoxItem>
                    <ListBoxItem><TextBlock Text="{Binding ImageLabel}" /></ListBoxItem>
                </ListBox>
                <TextBlock Grid.Column="1" FontSize="10" VerticalAlignment="Center"
                           TextAlignment="Right" TextTrimming="CharacterEllipsis" Margin="6,0,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                            <Setter Property="Text" Value="{Binding CountLabel}" />
                            <Setter Property="ToolTip" Value="{Binding CountLabel}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SearchHidesImages}" Value="True">
                                    <Setter Property="Text" Value="搜索仅匹配文本" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Grid>
