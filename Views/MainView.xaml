<Grid x:Class="ClipboardManager.Views.MainView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:ClipboardManager.Controls"
      xmlns:local="clr-namespace:ClipboardManager.Views"
      xmlns:utilities="clr-namespace:ClipboardManager.Utilities"
      Background="Transparent" UseLayoutRounding="True" SnapsToDevicePixels="True"
      TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Grid.Resources>
        <Style x:Key="HistoryFooterAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PressedSurfaceBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HistoryFilterTab" TargetType="RadioButton">
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RecordFavoriteAction" TargetType="Button" BasedOn="{StaticResource HistoryFooterAction}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HistorySettingsAction" TargetType="Button" BasedOn="{StaticResource HistoryFooterAction}">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PinnedBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RecordCopySurface" TargetType="Button" BasedOn="{StaticResource CopySurface}">
            <Setter Property="Padding" Value="6,0,4,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="ToolTip" Value="{x:Null}" />
            <EventSetter Event="MouseEnter" Handler="OnRecordPreviewMouseEnter" />
            <EventSetter Event="MouseLeave" Handler="OnRecordPreviewMouseLeave" />
            <EventSetter Event="Unloaded" Handler="OnRecordPreviewUnloaded" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnRecordDragMouseLeftButtonDown" />
            <EventSetter Event="PreviewMouseMove" Handler="OnRecordDragMouseMove" />
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnRecordDragMouseLeftButtonUp" />
        </Style>



        <sys:Double x:Key="HistoryRowHeight" xmlns:sys="clr-namespace:System;assembly=mscorlib">38</sys:Double>
        <sys:Double x:Key="HistoryImageRowHeight" xmlns:sys="clr-namespace:System;assembly=mscorlib">72</sys:Double>
        <DropShadowEffect x:Key="HoverPreviewShadow" Color="#42505A" BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.30" />
        <Style x:Key="HoverPreviewChrome" TargetType="ContentControl">
            <Setter Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource HoverPreviewBackgroundBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <!-- Only the card silhouette casts a shadow; text and scrolling stay outside the shader. -->
                            <Border Background="{TemplateBinding Background}" CornerRadius="10"
                                    Effect="{StaticResource HoverPreviewShadow}" IsHitTestVisible="False" />
                            <Border Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                                  ContentStringFormat="{TemplateBinding ContentStringFormat}" RecognizesAccessKey="True" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CompactScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" Opacity="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="ScrollThumb" MinHeight="24" Opacity="0.55">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Margin="2,1" CornerRadius="2" Background="{DynamicResource ScrollThumbBrush}" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" Opacity="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ScrollThumb" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger SourceName="ScrollThumb" Property="IsDragging" Value="True">
                                <Setter TargetName="ScrollThumb" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CompactScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Margin="{TemplateBinding Padding}"
                                                    Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                                    ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}" />
                            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Style="{StaticResource CompactScrollBar}"
                                       Orientation="Vertical" Minimum="0" Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}" Value="{TemplateBinding VerticalOffset}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HoverPreviewTextBox" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="IsInactiveSelectionHighlightEnabled" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="SelectionOpacity" Value="0.35" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Style="{StaticResource CompactScrollViewer}"
                                      VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                      HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HoverPreviewEditAction" TargetType="Button">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Chrome" CornerRadius="7" Opacity="0.72" BorderThickness="1"
                                    Background="{DynamicResource HoverPreviewBackgroundBrush}"
                                    BorderBrush="{DynamicResource GlassEdgeBrush}" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PressedSurfaceBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="HoverPreviewText">
            <StackPanel MaxWidth="400">
                <TextBlock Text="文本预览" FontSize="10.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}" Margin="1,0,0,7" />
                <TextBox x:Name="HoverPreviewTextContent" MaxHeight="280" Style="{StaticResource HoverPreviewTextBox}"
                         Text="{Binding HoverText, Mode=OneWay}" AutomationProperties.Name="可选择复制的文本预览"
                         ContextMenuOpening="OnHoverPreviewContextMenuOpening">
                    <TextBox.ContextMenu>
                        <ContextMenu Opened="OnHoverPreviewContextMenuOpening" Closed="OnHoverPreviewContextMenuClosed">
                            <MenuItem Header="复制" Command="ApplicationCommands.Copy"
                                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                        </ContextMenu>
                    </TextBox.ContextMenu>
                </TextBox>
                <TextBlock Text="{Binding ContentInfo}" Margin="1,7,0,0" FontSize="10.5"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="HoverPreviewImage">
            <StackPanel MaxWidth="400">
                <Border Background="{DynamicResource ImageWellBackgroundBrush}"
                        BorderBrush="{DynamicResource ImageWellBorderBrush}"
                        BorderThickness="1" CornerRadius="6" ClipToBounds="True" Padding="1" Margin="0,0,0,7">
                    <Grid>
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center">
                            <controls:AsyncThumbnail FilePath="{Binding ImagePath}" Stretch="Uniform"
                                                     Width="{Binding PreviewImageWidth}" Height="{Binding PreviewImageHeight}"
                                                     RenderOptions.BitmapScalingMode="HighQuality" />
                        </Viewbox>
                        <Button x:Name="HoverPreviewEditButton" Command="{Binding EditImageCommand}"
                                Style="{StaticResource HoverPreviewEditAction}" HorizontalAlignment="Right"
                                VerticalAlignment="Top" Margin="6" Click="OnHoverPreviewEditClick"
                                AutomationProperties.Name="编辑预览图片">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE70F;" FontSize="12" Margin="0,0,4,0" />
                                <TextBlock Text="编辑" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
                <TextBlock Text="{Binding ContentInfo}" HorizontalAlignment="Center" FontSize="10.5"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
        </DataTemplate>

    </Grid.Resources>

    <!-- Capsule: the preview copies the newest record; the chevron opens history. -->
    <Grid x:Name="Capsule" Width="240" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" AutomationProperties.Name="剪贴板小组件">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="40" />
        </Grid.ColumnDefinitions>
        <Border x:Name="CapsuleDragHandle" Grid.Column="0" Background="Transparent" Cursor="SizeAll"
                ToolTip="拖动移动小组件" AutomationProperties.Name="拖动移动小组件">
            <Ellipse Style="{StaticResource StatusDot}" HorizontalAlignment="Center" />
        </Border>
        <Button x:Name="LatestCopyButton" Grid.Column="1" Command="{Binding LatestRecord.CopyCommand}"
                Style="{StaticResource RecordCopySurface}" Tag="{Binding LatestRecord}" Padding="2,0" ClipToBounds="True"
                AutomationProperties.Name="复制最新记录" IsEnabled="{Binding HasRecords}" Focusable="True" IsTabStop="True">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Width="32" Height="28" Margin="0,0,6,0" CornerRadius="4" Padding="1"
                        Background="{DynamicResource ImageWellBackgroundBrush}" BorderBrush="{DynamicResource ImageWellBorderBrush}"
                        BorderThickness="1" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CapsuleImagePath, FallbackValue={x:Null}}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <controls:AsyncThumbnail FilePath="{Binding CapsuleImagePath}" Stretch="Uniform"
                                             RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding CapsuleText}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontSize" Value="11" />
                            <Setter Property="TextWrapping" Value="Wrap" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CapsuleImagePath, FallbackValue={x:Null}}" Value="{x:Null}">
                                    <Setter Property="FontSize" Value="12.5" />
                                    <Setter Property="TextWrapping" Value="NoWrap" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Button>
        <Border Grid.Column="2" Background="{DynamicResource TagBackgroundBrush}" BorderBrush="{DynamicResource TagBorderBrush}"
                BorderThickness="1" CornerRadius="9" Padding="7,0" Height="18" Margin="5,0,5,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding RecordCount}" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"
                       Foreground="{DynamicResource FilterSelectedForegroundBrush}" />
        </Border>
        <Border Grid.Column="3" BorderBrush="{DynamicResource CaptionDividerBrush}" BorderThickness="1,0,0,0"
                Margin="0,7,0,7" IsHitTestVisible="False" />
        <ToggleButton x:Name="HistoryToggleButton" Grid.Column="3" Style="{StaticResource PinCaptionButton}"
                      IsThreeState="False" ToolTip="显示历史记录" AutomationProperties.Name="显示历史记录"
                      HorizontalAlignment="Right" Margin="0,0,10,0">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="11" />
        </ToggleButton>
    </Grid>

    <Popup x:Name="HoverPreviewPopup" Placement="Custom" AllowsTransparency="True" StaysOpen="True"
           PopupAnimation="None" utilities:TransitionAnimations.EnterOnOpen="True" Focusable="False">
        <ContentControl x:Name="HoverPreviewSurface" Style="{StaticResource HoverPreviewChrome}" Padding="11,9,11,10"
                        ContentTemplateSelector="{x:Static local:MainView.RecordHoverSelector}"
                        Focusable="True" AutomationProperties.Name="剪贴板记录预览"
                        MouseEnter="OnHoverPreviewMouseEnter" MouseLeave="OnHoverPreviewMouseLeave"
                        LostMouseCapture="OnHoverPreviewLostMouseCapture" MouseDown="OnHoverPreviewMouseDown"
                        PreviewKeyDown="OnHoverPreviewKeyDown" />
    </Popup>

    <Popup x:Name="HistoryPopup" PlacementTarget="{Binding ElementName=Capsule}" Placement="Bottom"
           AllowsTransparency="True" StaysOpen="True" PopupAnimation="None" utilities:TransitionAnimations.EnterOnOpen="True" Focusable="False">
        <Border x:Name="HistoryPopupBorder" Width="300" MaxHeight="360" Padding="0"
                Background="{DynamicResource PopupBackgroundBrush}" BorderBrush="{DynamicResource GlassEdgeBrush}"
                BorderThickness="1" CornerRadius="12" RenderOptions.ClearTypeHint="Enabled">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Border x:Name="HistoryHeader" Padding="12,9" BorderBrush="{DynamicResource GlassEdgeBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton x:Name="HistoryTab" Content="历史" GroupName="HistoryFilter" Style="{StaticResource HistoryFilterTab}"
                                         IsChecked="{Binding IsShowingHistory, Mode=OneWay, FallbackValue=True}" Command="{Binding ShowHistoryCommand}"
                                         Click="OnHistoryFilterClick" AutomationProperties.Name="显示历史记录" />
                            <RadioButton x:Name="FavoritesTab" Content="收藏" GroupName="HistoryFilter" Style="{StaticResource HistoryFilterTab}"
                                         Margin="3,0,0,0" IsChecked="{Binding IsShowingFavorites, Mode=OneWay, FallbackValue=False}"
                                         Command="{Binding ShowFavoritesCommand}" Click="OnHistoryFilterClick" AutomationProperties.Name="显示收藏记录" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding ElementName=HistoryRecords, Path=Items.Count, StringFormat={}{0} 条}"
                                   FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <ListBox x:Name="HistoryRecords" Grid.Row="1" ItemsSource="{Binding HistoryRecords}"
                         MaxHeight="280" Background="Transparent" BorderThickness="0" Padding="5,4"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True"
                         AutomationProperties.Name="剪贴板历史记录下拉列表">
                    <ListBox.Resources>
                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource CompactScrollViewer}" />
                    </ListBox.Resources>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Height" Value="{StaticResource HistoryRowHeight}" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,1" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="HistoryRow" Background="Transparent" CornerRadius="6">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HistoryRow" Property="Background" Value="{DynamicResource RecordHoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="HistoryRow" Property="Background" Value="{DynamicResource SelectionBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsImage}" Value="True">
                                    <Setter Property="Height" Value="{StaticResource HistoryImageRowHeight}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Button Command="{Binding CopyCommand}" Tag="{Binding}" Style="{StaticResource RecordCopySurface}"
                                        Padding="7,5" AutomationProperties.Name="复制此历史记录" ContextMenuOpening="OnRecordContextMenuOpening">
                                    <Button.ContextMenu>
                                        <ContextMenu Closed="OnRecordContextMenuClosed">
                                            <MenuItem Header="编辑图片" Command="{Binding EditImageCommand}" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <Grid MinHeight="26">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding PositionLabel}" MinWidth="18" Margin="0,0,4,0" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                        <Border x:Name="HistoryThumbnail" Grid.Column="1" Width="76" Height="54" Margin="0,0,8,0"
                                                Background="{DynamicResource ImageWellBackgroundBrush}" BorderBrush="{DynamicResource ImageWellBorderBrush}"
                                                BorderThickness="1" CornerRadius="5" Padding="2" VerticalAlignment="Center" Visibility="Collapsed">
                                            <controls:AsyncThumbnail FilePath="{Binding ImagePath}" Stretch="Uniform"
                                                                     RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>
                                        <TextBlock x:Name="HistorySingleLine" Grid.Column="2" Text="{Binding SingleLine}" FontSize="12" VerticalAlignment="Center"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock x:Name="HistoryTime" Grid.Column="3" Text="{Binding ShortTimeLabel}" FontSize="10" Margin="8,0,1,0"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <StackPanel x:Name="HistoryImageInfo" Grid.Column="2" Grid.ColumnSpan="2" VerticalAlignment="Center" Visibility="Collapsed">
                                            <TextBlock Text="{Binding ContentInfo}" FontSize="11.5" TextWrapping="Wrap" MaxHeight="32"
                                                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding ShortTimeLabel}" FontSize="10.5" Margin="0,4,0,0"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Button x:Name="FavoriteButton" Grid.Column="1" Command="{Binding ToggleFavoriteCommand}"
                                        Style="{StaticResource RecordFavoriteAction}" VerticalAlignment="Center"
                                        ToolTip="{Binding FavoriteToolTip}" AutomationProperties.Name="{Binding FavoriteToolTip}">
                                    <TextBlock x:Name="FavoriteIcon" Style="{StaticResource Icon}" Text="&#xE734;" FontSize="14" />
                                </Button>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                    <Setter TargetName="FavoriteIcon" Property="Text" Value="&#xE735;" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsImage}" Value="True">
                                    <Setter TargetName="HistoryThumbnail" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="HistoryImageInfo" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="HistorySingleLine" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="HistoryTime" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="HistoryEmptyMessage" Grid.Row="1" Text="{Binding EmptyMessage, FallbackValue=暂无剪贴板记录}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=HistoryRecords, Path=HasItems}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Border x:Name="HistoryFooter" Grid.Row="2" Background="{DynamicResource ReadOnlyBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,11,11" Padding="10,8">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Button x:Name="SettingsButton" Command="{Binding SettingsCommand}" Style="{StaticResource HistorySettingsAction}"
                                HorizontalAlignment="Left" AutomationProperties.Name="打开设置">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" FontSize="13" Margin="0,0,6,0" />
                                <TextBlock Text="设置" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="MoreButton" Grid.Column="1" Content="更多 ⋯" Style="{StaticResource HistoryFooterAction}"
                                HorizontalAlignment="Right" AutomationProperties.Name="更多操作" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Popup>

</Grid>
