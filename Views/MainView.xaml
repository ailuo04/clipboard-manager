<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:ClipboardManager.Controls;assembly=ClipboardManager">
    <Grid.Resources>
        <DataTemplate x:Key="TextContent">
            <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                       MaxHeight="92" LineHeight="22" FontSize="14" />
        </DataTemplate>
        <DataTemplate x:Key="ImageContent">
            <Border Background="#F1F3F5" CornerRadius="4" Height="{Binding DataContext.ThumbnailHeight, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,2,0,0">
                <Grid Margin="6">
                    <controls:AsyncThumbnail x:Name="Thumbnail" FilePath="{Binding ImagePath}" Stretch="Uniform"
                                             RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="{Binding StatusText, ElementName=Thumbnail}" Style="{StaticResource SecondaryText}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>
        <Style x:Key="FilterItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="FilterChrome" Padding="{TemplateBinding Padding}" CornerRadius="5" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="FilterChrome" Property="Background" Value="#E4F1ED" />
                                <Setter Property="Foreground" Value="#106857" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="FilterChrome" Property="Opacity" Value="0.65" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FilterChrome" Property="BorderThickness" Value="1" /><Setter TargetName="FilterChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Grid.Resources>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
        <Grid>
            <Grid.Style><Style TargetType="Grid"><Setter Property="Margin" Value="24,20,24,18" /><Style.Triggers>
                <DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Margin" Value="16,12" /></DataTrigger>
            </Style.Triggers></Style></Grid.Style>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#E4F1ED" CornerRadius="6" Width="36" Height="36" Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE77F;" Foreground="#117466" FontSize="20" />
                </Border>
                <TextBlock Text="剪贴板" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource IconButton}" Command="{Binding ClearCommand}" ToolTip="清空全部历史记录"
                        AutomationProperties.Name="清空全部历史记录" Margin="0,0,8,0">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" />
                </Button>
                <Button Style="{StaticResource IconButton}" Command="{Binding SettingsCommand}" ToolTip="设置" AutomationProperties.Name="设置">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" />
                </Button>
            </StackPanel>
            <Grid Grid.Row="1" Grid.ColumnSpan="2">
                <Grid.Style><Style TargetType="Grid"><Setter Property="Margin" Value="0,18,0,0" /><Style.Triggers>
                    <DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Margin" Value="0,10,0,0" /></DataTrigger>
                </Style.Triggers></Style></Grid.Style>
                <TextBox Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" Padding="38,10,38,10" MinHeight="42"
                         AutomationProperties.Name="搜索文本内容" />
                <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" HorizontalAlignment="Left" Margin="13,0,0,0"
                           Foreground="#7B8390" IsHitTestVisible="False" />
                <TextBlock Text="搜索文本内容" Foreground="#8A919D" Margin="38,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding HasSearch}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button Style="{StaticResource IconButton}" Command="{Binding ClearSearchCommand}" ToolTip="清除搜索" AutomationProperties.Name="清除搜索"
                        HorizontalAlignment="Right" Margin="0,0,3,0" Width="32" Height="32" MinHeight="32" BorderThickness="0" Background="Transparent"
                        Visibility="{Binding HasSearch, Converter={StaticResource BoolVisibility}}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="12" />
                </Button>
            </Grid>
        </Grid>
    </Border>

    <Grid Grid.Row="1">
        <Grid.Style><Style TargetType="Grid"><Setter Property="Margin" Value="24,14,24,10" /><Style.Triggers>
            <DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Margin" Value="16,8" /></DataTrigger>
        </Style.Triggers></Style></Grid.Style>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <ListBox BorderThickness="0" Background="Transparent" SelectedIndex="{Binding FilterIndex, Mode=TwoWay}"
                 ItemContainerStyle="{StaticResource FilterItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="内容类型筛选">
            <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
            <ListBoxItem><TextBlock Text="{Binding AllLabel}" /></ListBoxItem>
            <ListBoxItem><TextBlock Text="{Binding TextLabel}" /></ListBoxItem>
            <ListBoxItem><TextBlock Text="{Binding ImageLabel}" /></ListBoxItem>
        </ListBox>
        <TextBlock Grid.Column="1" Text="最新在前" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="8,0,0,0" />
    </Grid>

    <Border Grid.Row="2" Background="#FFF3D9" BorderBrush="#F0D69E" BorderThickness="1" CornerRadius="6"
            Visibility="{Binding HasNotice, Converter={StaticResource BoolVisibility}}">
        <Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="24,0,24,12" /><Style.Triggers>
            <DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Margin" Value="16,0,16,8" /></DataTrigger>
        </Style.Triggers></Style></Border.Style>
        <Grid Margin="12,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" Foreground="#704E13" VerticalAlignment="Center" Margin="0,0,10,0" MaxHeight="110" TextTrimming="CharacterEllipsis" ToolTip="{Binding Notice}" />
            <Button Grid.Column="1" Style="{StaticResource IconButton}" Command="{Binding DismissNoticeCommand}" Background="Transparent"
                    BorderThickness="0" Width="28" Height="28" MinHeight="28" ToolTip="关闭提示" AutomationProperties.Name="关闭提示">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="12" />
            </Button>
        </Grid>
    </Border>

    <Grid Grid.Row="3">
        <ListBox ItemsSource="{Binding VisibleRecords}" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 ScrollViewer.CanContentScroll="True" HorizontalContentAlignment="Stretch" AutomationProperties.Name="剪贴板历史记录">
            <ListBox.Style><Style TargetType="ListBox"><Setter Property="Padding" Value="24,0,24,12" /><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True">
                <Setter Property="Padding" Value="16,0,16,8" />
            </DataTrigger></Style.Triggers></Style></ListBox.Style>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Margin" Value="0,0,0,10" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value></Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="White" CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                            <Button Command="{Binding CopyCommand}" Style="{StaticResource CopySurface}" ToolTip="{Binding CopyToolTip}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Border CornerRadius="3" Padding="7,3">
                                            <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#ECF1FA" /><Style.Triggers><DataTrigger Binding="{Binding IsImage}" Value="True"><Setter Property="Background" Value="#FAEDDF" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                            <TextBlock Text="{Binding TypeLabel}" FontSize="11" Foreground="#485666" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Style="{StaticResource Icon}" Text="&#xE718;" FontSize="12" Foreground="#117466" Margin="8,0,0,0"
                                                   Visibility="{Binding IsPinned, Converter={StaticResource BoolVisibility}}" ToolTip="已固定" />
                                        <TextBlock Grid.Column="2" Text="{Binding TimeLabel}" Style="{StaticResource SecondaryText}" HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" ToolTip="{Binding FullTime}" Margin="8,0,0,0" />
                                    </Grid>
                                    <ContentControl Grid.Row="1" Content="{Binding}" HorizontalContentAlignment="Stretch">
                                        <ContentControl.Style><Style TargetType="ContentControl"><Setter Property="ContentTemplate" Value="{StaticResource TextContent}" />
                                            <Style.Triggers><DataTrigger Binding="{Binding IsImage}" Value="True"><Setter Property="ContentTemplate" Value="{StaticResource ImageContent}" /></DataTrigger></Style.Triggers>
                                        </Style></ContentControl.Style>
                                    </ContentControl>
                                    <TextBlock Grid.Row="2" Text="{Binding ContentInfo}" Style="{StaticResource SecondaryText}" Margin="0,10,0,0" />
                                </Grid>
                            </Button>
                            <StackPanel Grid.Column="1" Margin="0,10,10,10" VerticalAlignment="Top">
                                <Button Command="{Binding PinCommand}" ToolTip="{Binding PinToolTip}" AutomationProperties.Name="{Binding PinToolTip}" Margin="0,0,0,4">
                                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource IconButton}"><Setter Property="BorderThickness" Value="0" /><Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers><DataTrigger Binding="{Binding IsPinned}" Value="True"><Setter Property="Background" Value="#E4F1ED" /><Setter Property="Foreground" Value="#117466" /></DataTrigger></Style.Triggers>
                                    </Style></Button.Style>
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE718;" />
                                </Button>
                                <Button Command="{Binding DetailsCommand}" Style="{StaticResource IconButton}" ToolTip="查看完整内容" AutomationProperties.Name="查看完整内容" BorderThickness="0" Margin="0,0,0,4">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" />
                                </Button>
                                <Button Command="{Binding DeleteCommand}" Style="{StaticResource IconButton}" ToolTip="删除记录" AutomationProperties.Name="删除记录" BorderThickness="0" Foreground="#A53A3A">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE8F1;" FontSize="36" Foreground="#9BA4AE" Margin="0,0,0,16" />
            <TextBlock Text="{Binding EmptyTitle}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding EmptySubtitle}" Foreground="#7B8390" Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center" />
            <Button Content="重试" Command="{Binding RetryCommand}" HorizontalAlignment="Center" Margin="0,16,0,0" MinWidth="90"
                    Visibility="{Binding CanRetry, Converter={StaticResource BoolVisibility}}" />
        </StackPanel>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsLoading, Converter={StaticResource BoolVisibility}}">
            <ProgressBar IsIndeterminate="True" Width="160" Height="3" Foreground="{StaticResource AccentBrush}" />
            <TextBlock Text="正在加载历史记录…" Foreground="#6B7280" Margin="0,14,0,0" />
        </StackPanel>
    </Grid>

    <Border Grid.Row="4" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
        <Grid Margin="24,10">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding MonitorStatus}" FontSize="12" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                <Button Style="{StaticResource IconButton}" Command="{Binding PauseCommand}" ToolTip="{Binding PauseToolTip}" AutomationProperties.Name="{Binding PauseToolTip}"
                        Height="26" Width="26" MinHeight="26" BorderThickness="0" Margin="6,0,0,0">
                    <TextBlock FontSize="12">
                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Icon}"><Setter Property="Text" Value="&#xE769;" />
                            <Style.Triggers><DataTrigger Binding="{Binding IsPaused}" Value="True"><Setter Property="Text" Value="&#xE768;" /></DataTrigger></Style.Triggers>
                        </Style></TextBlock.Style>
                    </TextBlock>
                </Button>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding CountLabel}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="12,0,0,0" />
            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Status}" Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
        </Grid>
    </Border>
</Grid>
