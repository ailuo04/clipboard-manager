    <SolidColorBrush x:Key="ErrorTextBrush" Color="#F0A0A0" />
    <SolidColorBrush x:Key="DangerTextBrush" Color="#EAA6AA" />

    <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#D51B1B1F" Offset="0" />
        <GradientStop Color="#BA39353B" Offset="0.5" />
        <GradientStop Color="#DB16171B" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SurfaceBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#18383840" Offset="0" />
        <GradientStop Color="#10303038" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RaisedSurfaceBrush" StartPoint="0,0" EndPoint="0.8,1">
        <GradientStop Color="#50656570" Offset="0" />
        <GradientStop Color="#323D3C45" Offset="0.45" />
        <GradientStop Color="#45545260" Offset="0.88" />
        <GradientStop Color="#686F829A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SoftSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#407B7982" Offset="0" />
        <GradientStop Color="#283E3D46" Offset="0.6" />
        <GradientStop Color="#40666370" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassSheenBrush" StartPoint="0,0" EndPoint="0.2,1">
        <GradientStop Color="#17FFFFFF" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="0.24" />
        <GradientStop Color="#00FFFFFF" Offset="0.8" />
        <GradientStop Color="#12B9D6FF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassEdgeBrush" StartPoint="0,0" EndPoint="0.8,1">
        <GradientStop Color="#85FFFFFF" Offset="0" />
        <GradientStop Color="#28FFFFFF" Offset="0.28" />
        <GradientStop Color="#0CFFFFFF" Offset="0.6" />
        <GradientStop Color="#38FFFFFF" Offset="0.85" />
        <GradientStop Color="#879CC6F4" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SelectionBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#526482A0" Offset="0" />
        <GradientStop Color="#32465972" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PrimaryBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#228671" Offset="0" />
        <GradientStop Color="#146F61" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PrimaryHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2A9A83" Offset="0" />
        <GradientStop Color="#177A6A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PrimaryPressedBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1D7563" Offset="0" />
        <GradientStop Color="#0F5F54" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="EmptyPanelBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#70484450" Offset="0" />
        <GradientStop Color="#6033323C" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
