<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark "liquid glass" palette. All dynamic theme keys live here. -->
    <Color x:Key="AccentColor">#9AC6FF</Color>
    <Color x:Key="AccentGlowColor">#669AC6FF</Color>
    <Color x:Key="CardShadowColor">#000000</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#2C4358" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F3F3F5" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#BABAC2" />
    <SolidColorBrush x:Key="BorderBrush" Color="#35FFFFFF" />
    <SolidColorBrush x:Key="GlassStrokeBrush" Color="#40FFFFFF" />
    <SolidColorBrush x:Key="GlassShadowBrush" Color="#27182A31" />
    <SolidColorBrush x:Key="HoverSurfaceBrush" Color="#557F7D87" />
    <SolidColorBrush x:Key="PressedSurfaceBrush" Color="#806A778A" />
    <SolidColorBrush x:Key="PinnedGlassBrush" Color="#45618CB5" />
    <SolidColorBrush x:Key="PinnedBorderBrush" Color="#A7D4C6" />
    <SolidColorBrush x:Key="ToolTipBackgroundBrush" Color="#F21B1C21" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#65FFFFFF" />
    <SolidColorBrush x:Key="ControlShadowBrush" Color="#40000000" />
    <SolidColorBrush x:Key="ControlHoverBorderBrush" Color="#B8FFFFFF" />
    <SolidColorBrush x:Key="InputShadowBrush" Color="#1C04232A" />
    <SolidColorBrush x:Key="InputFocusBackgroundBrush" Color="#E62A2B31" />
    <SolidColorBrush x:Key="InputFocusBorderBrush" Color="#A0BAD6F5" />
    <SolidColorBrush x:Key="TextSelectionBrush" Color="#587EABD8" />
    <SolidColorBrush x:Key="PrimaryBorderBrush" Color="#7FFFFFFF" />
    <SolidColorBrush x:Key="PrimaryForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CaptionBarBrush" Color="#10343440" />
    <SolidColorBrush x:Key="CaptionForegroundBrush" Color="#DDDEE5" />
    <SolidColorBrush x:Key="CaptionHoverBrush" Color="#5CFFFFFF" />
    <SolidColorBrush x:Key="CaptionPressedBrush" Color="#30FFFFFF" />
    <SolidColorBrush x:Key="CaptionDividerBrush" Color="#487F8D8E" />
    <SolidColorBrush x:Key="CaptionSeparatorBrush" Color="#35757F80" />
    <SolidColorBrush x:Key="CloseHoverBrush" Color="#C42B2B" />
    <SolidColorBrush x:Key="ClosePressedBrush" Color="#A52626" />
    <SolidColorBrush x:Key="FilterPanelBrush" Color="#183C3B42" />
    <SolidColorBrush x:Key="FilterPanelBorderBrush" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="FilterHoverBrush" Color="#4FFFFFFF" />
    <SolidColorBrush x:Key="FilterSelectedBorderBrush" Color="#A8FFFFFF" />
    <SolidColorBrush x:Key="FilterSelectedForegroundBrush" Color="#F2F5FF" />
    <SolidColorBrush x:Key="NoticeBackgroundBrush" Color="#FFF2D9" />
    <SolidColorBrush x:Key="NoticeBorderBrush" Color="#F0D69E" />
    <SolidColorBrush x:Key="NoticeTextBrush" Color="#704E13" />
    <SolidColorBrush x:Key="RecordShadowBrush" Color="#1D213D43" />
    <SolidColorBrush x:Key="RecordHoverBrush" Color="#607C7A85" />
    <SolidColorBrush x:Key="RecordHoverBorderBrush" Color="#BAFFFFFF" />
    <SolidColorBrush x:Key="RecordSelectedBorderBrush" Color="#809CC6F4" />
    <SolidColorBrush x:Key="TagBackgroundBrush" Color="#305A6578" />
    <SolidColorBrush x:Key="TagBorderBrush" Color="#7CFFFFFF" />
    <SolidColorBrush x:Key="TagImageBackgroundBrush" Color="#405D5060" />
    <SolidColorBrush x:Key="TagTextBrush" Color="#CFD5E1" />
    <SolidColorBrush x:Key="ActionPanelBrush" Color="#24353540" />
    <SolidColorBrush x:Key="PinActiveBackgroundBrush" Color="#405A7BA0" />
    <SolidColorBrush x:Key="EmptyIconBackgroundBrush" Color="#303C4B60" />
