<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid Margin="0,0,0,16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel>
            <TextBlock Text="{Binding TypeLabel}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{Binding FullTime}" Style="{StaticResource SecondaryText}" Margin="0,6,0,0" />
        </StackPanel>
        <Button x:Name="CopyButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" ToolTip="复制完整内容到剪贴板" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" Margin="0,0,8,0" /><TextBlock Text="复制" /></StackPanel>
        </Button>
    </Grid>
    <TextBox Grid.Row="1" Text="{Binding Record.Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14" AutomationProperties.Name="完整文本内容">
        <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Style.Triggers>
            <DataTrigger Binding="{Binding IsImage}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
        </Style.Triggers></Style></TextBox.Style>
    </TextBox>
    <Grid Grid.Row="1" Visibility="{Binding IsImage, Converter={StaticResource BoolVisibility}}">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Background="{DynamicResource ImageWellBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
            <Grid>
                <ScrollViewer x:Name="ImageScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled" Padding="10">
                    <Image x:Name="FullImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                </ScrollViewer>
                <TextBlock x:Name="ImageStatus" Text="正在加载原图…" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="16" />
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <CheckBox x:Name="FitCheckBox" Content="适应窗口" IsChecked="True" VerticalAlignment="Center" />
            <Slider x:Name="ZoomSlider" Grid.Column="1" Minimum="0.25" Maximum="3" Value="1" IsEnabled="False" SmallChange="0.25" LargeChange="0.5" Margin="20,0" VerticalAlignment="Center" AutomationProperties.Name="图片缩放比例" />
            <TextBlock x:Name="ZoomLabel" Grid.Column="2" Text="适应" Width="48" TextAlignment="Right" VerticalAlignment="Center" />
        </Grid>
    </Grid>
    <Grid Grid.Row="2" Margin="0,16,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusLabel" Text="{Binding ContentInfo}" Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0" />
        <Button x:Name="CloseButton" Grid.Column="1" Content="关闭" IsCancel="True" MinWidth="84" />
    </Grid>
</Grid>
