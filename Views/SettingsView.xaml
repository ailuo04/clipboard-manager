<Grid x:Class="ClipboardManager.Views.SettingsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      AutomationProperties.Name="设置" Margin="0" MinWidth="430">
    <Grid.Resources>
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SoftSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GlassStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16,14" />
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="2,0,0,8" />
        </Style>
    </Grid.Resources>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Height="0" />

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20,24,8">
        <StackPanel>

            <TextBlock Text="外观" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,18">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource GlassStrokeBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="3" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ThemeDarkRadio" GroupName="AppTheme" Style="{StaticResource ThemeChoice}"
                                             ToolTip="深色" AutomationProperties.Name="深色主题">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE708;" FontSize="17" />
                                </RadioButton>
                                <RadioButton x:Name="ThemeLightRadio" GroupName="AppTheme" Style="{StaticResource ThemeChoice}"
                                             ToolTip="浅色" AutomationProperties.Name="浅色主题">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE706;" FontSize="17" />
                                </RadioButton>
                                <RadioButton x:Name="ThemeSystemRadio" GroupName="AppTheme" Style="{StaticResource ThemeChoice}"
                                             ToolTip="跟随系统" AutomationProperties.Name="跟随系统主题">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" FontSize="17" />
                                </RadioButton>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="跟随系统会根据 Windows 的应用主题自动切换。" Style="{StaticResource SecondaryText}"
                               TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="存储" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,18">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="132" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="记录数量上限" />
                            <TextBlock Text="50 – 5000 条" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
                        </StackPanel>
                        <TextBox Grid.Column="1" x:Name="MaxRecordsBox" AutomationProperties.Name="记录数量上限" MaxLength="4" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="132" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="内容空间上限" />
                            <TextBlock Text="64 – 4096 MB" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
                        </StackPanel>
                        <TextBox Grid.Column="1" x:Name="MaxStorageBox" AutomationProperties.Name="内容空间上限（MB）" MaxLength="4" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="行为" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,18">
                <StackPanel>
                    <CheckBox x:Name="HideAfterCopyCheckBox" Content="复制后自动隐藏窗口"
                              AutomationProperties.Name="复制后自动隐藏窗口" />
                    <TextBlock Text="复制记录后窗口自动隐藏，方便立即粘贴到目标程序。"
                               Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="24,5,0,0" />
                    <CheckBox x:Name="AlwaysOnTopCheckBox" Content="窗口置顶" AutomationProperties.Name="窗口置顶" Margin="0,14,0,0" />
                    <CheckBox x:Name="MinimizeToTrayCheckBox" Content="关闭窗口时最小化到系统托盘"
                              AutomationProperties.Name="关闭窗口时最小化到系统托盘" Margin="0,14,0,0" />
                    <TextBlock Text="启用后关闭窗口不会退出；除非暂停，剪贴板仍会继续监听。"
                               Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="24,5,0,0" />
                    <CheckBox x:Name="AutoCheckUpdatesCheckBox" Content="自动检查更新" AutomationProperties.Name="自动检查更新" Margin="0,14,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="数据" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="数据目录" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="DirectoryBox" IsReadOnly="True" TextWrapping="Wrap" Background="{DynamicResource ReadOnlyBackgroundBrush}"
                                 FontSize="12" BorderThickness="0" />
                        <Button x:Name="OpenDirectoryButton" Grid.Column="1" Style="{StaticResource IconButton}"
                                ToolTip="打开数据目录" AutomationProperties.Name="打开数据目录" Margin="8,0,0,0">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xED25;" />
                        </Button>
                    </Grid>
                    <Button x:Name="OpenLogButton" HorizontalAlignment="Left" Margin="0,10,0,0" BorderThickness="0"
                            Background="Transparent" Padding="0,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" Margin="0,0,8,0" />
                            <TextBlock Text="查看日志" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <TextBlock Text="关于" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource SettingsCard}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="剪贴板" FontWeight="SemiBold" />
                        <TextBlock x:Name="SettingsVersionText" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
                    </StackPanel>
                    <Button x:Name="OpenUpdatesButton" Grid.Column="1" Style="{StaticResource IconButton}"
                            ToolTip="检查应用更新" AutomationProperties.Name="检查应用更新">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE895;" />
                    </Button>
                </Grid>
            </Border>

            <TextBlock x:Name="ValidationText" Foreground="{DynamicResource ErrorTextBrush}" TextWrapping="Wrap" Margin="2,16,0,0" />
        </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Background="{DynamicResource StatusBarBrush}" BorderBrush="{DynamicResource GlassEdgeBrush}"
            BorderThickness="0,1,0,0" Padding="24,14">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="取消" IsCancel="True" MinWidth="88" Margin="0,0,10,0" />
            <Button x:Name="SaveButton" Content="保存" IsDefault="True" Style="{StaticResource PrimaryButton}" MinWidth="88" />
        </StackPanel>
    </Border>
</Grid>
