<Grid x:Class="ClipboardManager.Views.SettingsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      AutomationProperties.Name="设置" Margin="0" TextElement.FontSize="12.5">
    <Grid.Resources>
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SoftSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GlassStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="2,0,0,6" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="LimitBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
    </Grid.Resources>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Height="0" />

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,2,12,0">
        <StackPanel>

            <TextBlock Text="外观" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource GlassStrokeBrush}"
                            BorderThickness="1" CornerRadius="11" Padding="3" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ThemeDarkRadio" GroupName="AppTheme" Style="{StaticResource ThemeChoice}" Height="30"
                                         ToolTip="深色" AutomationProperties.Name="深色主题">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE708;" />
                            </RadioButton>
                            <RadioButton x:Name="ThemeLightRadio" GroupName="AppTheme" Style="{StaticResource ThemeChoice}" Height="30"
                                         ToolTip="浅色" AutomationProperties.Name="浅色主题">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE706;" />
                            </RadioButton>
                            <RadioButton x:Name="ThemeSystemRadio" GroupName="AppTheme" Style="{StaticResource ThemeChoice}" Height="30"
                                         ToolTip="跟随系统" AutomationProperties.Name="跟随系统主题">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" />
                            </RadioButton>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="深色、浅色，或跟随 Windows 的应用主题。" Style="{StaticResource Hint}" Margin="0,7,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="存储" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="68" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="记录数量上限" />
                            <TextBlock Text="50 – 5000 条" Style="{StaticResource Hint}" Margin="0,2,0,0" />
                        </StackPanel>
                        <TextBox Grid.Column="1" x:Name="MaxRecordsBox" Style="{StaticResource LimitBox}"
                                 AutomationProperties.Name="记录数量上限" MaxLength="4" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="68" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="内容空间上限" />
                            <TextBlock Text="64 – 4096 MB" Style="{StaticResource Hint}" Margin="0,2,0,0" />
                        </StackPanel>
                        <TextBox Grid.Column="1" x:Name="MaxStorageBox" Style="{StaticResource LimitBox}"
                                 AutomationProperties.Name="内容空间上限（MB）" MaxLength="4" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="行为" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <CheckBox x:Name="HideCapsulePreviewCheckBox" Content="胶囊上不显示最新内容"
                              AutomationProperties.Name="胶囊上不显示最新内容" />
                    <TextBlock Text="胶囊始终置顶；启用后只显示“剪贴板”和条数。"
                               Style="{StaticResource Hint}" Margin="22,3,0,0" />
                    <CheckBox x:Name="MinimizeToTrayCheckBox" Content="关闭窗口时最小化到托盘"
                              AutomationProperties.Name="关闭窗口时最小化到系统托盘" Margin="0,10,0,0" />
                    <TextBlock Text="关闭窗口不会退出；除非暂停，仍会继续监听。"
                               Style="{StaticResource Hint}" Margin="22,3,0,0" />
                    <CheckBox x:Name="AutoCheckUpdatesCheckBox" Content="自动检查更新" AutomationProperties.Name="自动检查更新" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="数据" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="数据目录" />
                            <TextBox x:Name="DirectoryBox" IsReadOnly="True" TextWrapping="Wrap" Background="{DynamicResource ReadOnlyBackgroundBrush}"
                                     Foreground="{DynamicResource TextSecondaryBrush}" AutomationProperties.Name="数据目录"
                                     FontSize="11" BorderThickness="0" Padding="6,4" Margin="0,5,0,0" />
                        </StackPanel>
                        <Button x:Name="OpenDirectoryButton" Grid.Column="1" Style="{StaticResource IconButton}" Width="28" Height="28" MinHeight="28"
                                ToolTip="打开数据目录" AutomationProperties.Name="打开数据目录" Margin="8,0,0,0">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xED25;" FontSize="13" />
                        </Button>
                    </Grid>
                    <Button x:Name="OpenLogButton" HorizontalAlignment="Left" Margin="0,6,0,0" BorderThickness="0"
                            Background="Transparent" Padding="0,2" MinHeight="24">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" FontSize="13" Margin="0,0,6,0" />
                            <TextBlock Text="查看日志" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <TextBlock Text="关于" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource SettingsCard}" Margin="0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="剪贴板" FontWeight="SemiBold" />
                        <TextBlock x:Name="SettingsVersionText" Style="{StaticResource Hint}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button x:Name="OpenUpdatesButton" Grid.Column="1" Content="检查更新" Padding="10,4" MinHeight="28"
                            VerticalAlignment="Center" AutomationProperties.Name="检查应用更新" />
                </Grid>
            </Border>

            <TextBlock x:Name="ValidationText" Foreground="{DynamicResource ErrorTextBrush}" TextWrapping="Wrap" Margin="2,8,0,4"
                       FontSize="11.5" />
        </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" BorderBrush="{DynamicResource GlassEdgeBrush}" BorderThickness="0,1,0,0" Padding="12,9">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="取消" IsCancel="True" MinWidth="68" MinHeight="28" Padding="10,4" Margin="0,0,8,0" />
            <Button x:Name="SaveButton" Content="保存" IsDefault="True" Style="{StaticResource PrimaryButton}" MinWidth="68" MinHeight="28" Padding="10,4" />
        </StackPanel>
    </Border>
</Grid>
