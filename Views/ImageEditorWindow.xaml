<Window x:Class="ClipboardManager.Views.ImageEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ClipboardManager.Controls"
        Style="{StaticResource {x:Type Window}}" Background="{DynamicResource EditorWindowFill}"
        Title="编辑图片" Width="960" Height="700" MinWidth="620" MinHeight="440"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        AutomationProperties.Name="图片标注编辑器">
    <Window.Resources>
        <!-- Local defaults are available during XAML initialization; ApplyEditorPalette updates them for the active theme. -->
        <SolidColorBrush x:Key="EditorWindowFill" Color="#F6F8FA" />
        <SolidColorBrush x:Key="EditorRibbonFill" Color="#FFFFFF" />
        <SolidColorBrush x:Key="EditorWorkspaceFill" Color="#EDF1F4" />
        <SolidColorBrush x:Key="EditorControlFill" Color="#FFFFFF" />
        <SolidColorBrush x:Key="EditorToolFill" Color="#F5F7F9" />
        <SolidColorBrush x:Key="EditorControlBorder" Color="#D5DDE3" />
        <SolidColorBrush x:Key="EditorDividerBrush" Color="#E1E7EC" />
        <SolidColorBrush x:Key="EditorHoverFill" Color="#EDF2F5" />
        <SolidColorBrush x:Key="EditorHoverBorder" Color="#A6B8BD" />
        <SolidColorBrush x:Key="EditorPressedFill" Color="#DEE8EC" />
        <SolidColorBrush x:Key="EditorSelectedFill" Color="#E3F2ED" />
        <SolidColorBrush x:Key="EditorSelectedHoverFill" Color="#D6EDE5" />
        <SolidColorBrush x:Key="EditorSelectedPressedFill" Color="#C0E0D4" />
        <SolidColorBrush x:Key="EditorAccentBorder" Color="#2E8979" />
        <SolidColorBrush x:Key="EditorAccentText" Color="#186B5C" />
        <SolidColorBrush x:Key="EditorDisabledFill" Color="#F0F3F5" />
        <SolidColorBrush x:Key="EditorDisabledText" Color="#7C8993" />
        <SolidColorBrush x:Key="EditorPrimaryFill" Color="#137D68" />
        <SolidColorBrush x:Key="EditorPrimaryHoverFill" Color="#0F705E" />
        <SolidColorBrush x:Key="EditorPrimaryPressedFill" Color="#0C5D4F" />
        <SolidColorBrush x:Key="EditorDangerText" Color="#AD434D" />
        <SolidColorBrush x:Key="EditorDangerHoverFill" Color="#FBECEE" />
        <SolidColorBrush x:Key="EditorPopupFill" Color="#FFFFFF" />
        <Style x:Key="EditorAction" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource EditorControlFill}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EditorControlBorder}" />
            <Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="12" /><Setter Property="Height" Value="32" /><Setter Property="MinHeight" Value="32" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="FocusRing" BorderBrush="{DynamicResource EditorAccentBorder}" BorderThickness="2" CornerRadius="8" Margin="-2" Opacity="0" IsHitTestVisible="False" />
                            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter x:Name="ContentSite" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource EditorHoverFill}" /><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource EditorHoverBorder}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource EditorPressedFill}" /></Trigger>
                            <MultiTrigger><MultiTrigger.Conditions><Condition Property="Tag" Value="SelectedTool" /><Condition Property="IsMouseOver" Value="True" /></MultiTrigger.Conditions><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource EditorSelectedHoverFill}" /><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource EditorAccentBorder}" /></MultiTrigger>
                            <MultiTrigger><MultiTrigger.Conditions><Condition Property="Tag" Value="SelectedTool" /><Condition Property="IsPressed" Value="True" /></MultiTrigger.Conditions><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource EditorSelectedPressedFill}" /></MultiTrigger>
                            <MultiTrigger><MultiTrigger.Conditions><Condition Property="Tag" Value="Danger" /><Condition Property="IsMouseOver" Value="True" /></MultiTrigger.Conditions><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource EditorDangerHoverFill}" /><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource EditorDangerText}" /></MultiTrigger>
                            <MultiTrigger><MultiTrigger.Conditions><Condition Property="Tag" Value="Primary" /><Condition Property="IsMouseOver" Value="True" /></MultiTrigger.Conditions><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource EditorPrimaryHoverFill}" /><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource EditorPrimaryHoverFill}" /></MultiTrigger>
                            <MultiTrigger><MultiTrigger.Conditions><Condition Property="Tag" Value="Primary" /><Condition Property="IsPressed" Value="True" /></MultiTrigger.Conditions><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource EditorPrimaryPressedFill}" /></MultiTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Opacity" Value="0.28" /><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource EditorAccentBorder}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource EditorDisabledFill}" /><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource EditorDividerBrush}" /><Setter TargetName="ContentSite" Property="Opacity" Value="0.45" /><Setter TargetName="FocusRing" Property="Opacity" Value="0" /><Setter Property="Foreground" Value="{DynamicResource EditorDisabledText}" /></Trigger>
                            <MultiTrigger><MultiTrigger.Conditions><Condition Property="Tag" Value="Primary" /><Condition Property="IsEnabled" Value="False" /></MultiTrigger.Conditions><Setter TargetName="ContentSite" Property="Opacity" Value="1" /></MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InsertAction" TargetType="Button" BasedOn="{StaticResource EditorAction}">
            <Setter Property="Width" Value="48" /><Setter Property="Height" Value="64" />
            <Setter Property="Padding" Value="3,5" /><Setter Property="Margin" Value="0,0,4,0" />
        </Style>
        <Style x:Key="EditorPrimaryAction" TargetType="Button" BasedOn="{StaticResource EditorAction}">
            <Setter Property="Tag" Value="Primary" /><Setter Property="Background" Value="{DynamicResource EditorPrimaryFill}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EditorPrimaryFill}" /><Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" /><Setter Property="MinWidth" Value="112" />
        </Style>
        <Style x:Key="EditorDangerAction" TargetType="Button" BasedOn="{StaticResource EditorAction}">
            <Setter Property="Tag" Value="Danger" /><Setter Property="Foreground" Value="{DynamicResource EditorDangerText}" />
        </Style>
        <Style x:Key="EditorInput" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /><Setter Property="Background" Value="{DynamicResource EditorControlFill}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EditorControlBorder}" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="32" /><Setter Property="MinHeight" Value="32" /><Setter Property="CaretBrush" Value="{DynamicResource EditorAccentBorder}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource EditorSelectedFill}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="FocusRing" BorderBrush="{DynamicResource EditorAccentBorder}" BorderThickness="2" CornerRadius="8" Margin="-2" Opacity="0" IsHitTestVisible="False" />
                            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource EditorHoverBorder}" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource EditorAccentBorder}" /><Setter TargetName="FocusRing" Property="Opacity" Value="0.28" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource EditorDisabledFill}" /><Setter TargetName="PART_ContentHost" Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EditorStepper" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource EditorControlFill}" /><Setter Property="BorderBrush" Value="{DynamicResource EditorControlBorder}" />
            <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="6" /><Setter Property="Height" Value="32" /><Setter Property="Width" Value="130" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource EditorHoverBorder}" /></Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource EditorAccentBorder}" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{DynamicResource EditorDisabledFill}" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StepperButton" TargetType="Button" BasedOn="{StaticResource EditorAction}">
            <Setter Property="Width" Value="28" /><Setter Property="Height" Value="30" /><Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="0" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="5" Margin="1" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource EditorHoverFill}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource EditorPressedFill}" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource EditorAccentBorder}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StepperInput" TargetType="TextBox" BasedOn="{StaticResource EditorInput}">
            <Setter Property="Height" Value="30" /><Setter Property="MinHeight" Value="30" /><Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" /><Setter Property="Padding" Value="4,0" /><Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" /></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="InlineTextInput" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" /><Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource SelectionBrush}" />
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" Focusable="False" /></ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FontChoiceStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /><Setter Property="Padding" Value="8,7" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Choice" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <Grid><Path x:Name="SelectedMark" Data="M0,4 L3,7 L9,0" Stroke="{DynamicResource EditorAccentText}" StrokeThickness="1.7" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed" /><ContentPresenter Margin="18,0,2,0" /></Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Choice" Property="Background" Value="{DynamicResource EditorHoverFill}" /></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Choice" Property="Background" Value="{DynamicResource EditorSelectedFill}" /><Setter TargetName="SelectedMark" Property="Visibility" Value="Visible" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FontSelectorStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /><Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="{DynamicResource EditorControlFill}" /><Setter Property="BorderBrush" Value="{DynamicResource EditorControlBorder}" />
            <Setter Property="Height" Value="32" /><Setter Property="ItemContainerStyle" Value="{StaticResource FontChoiceStyle}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" /><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="FocusRing" BorderBrush="{DynamicResource EditorAccentBorder}" BorderThickness="2" CornerRadius="8" Margin="-2" Opacity="0" IsHitTestVisible="False" />
                            <ToggleButton x:Name="DropDownToggle" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" Foreground="{TemplateBinding Foreground}">
                                <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6"><Path Data="M0,0 L4,4 L8,0" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" StrokeLineJoin="Round" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0" /></Border></ControlTemplate></ToggleButton.Template>
                            </ToggleButton>
                            <TextBlock Margin="10,0,30,0" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis" Text="{Binding SelectedItem.DisplayName, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False">
                                <Border Background="{DynamicResource EditorPopupFill}" BorderBrush="{DynamicResource EditorControlBorder}" BorderThickness="1" CornerRadius="8"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Padding="4" Margin="6,4,6,8">
                                    <Border.Effect><DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="2" Opacity="0.16" /></Border.Effect>
                                    <ScrollViewer MaxHeight="280"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" /></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="DropDownToggle" Property="BorderBrush" Value="{DynamicResource EditorHoverBorder}" /></Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="DropDownToggle" Property="Background" Value="{DynamicResource EditorSelectedFill}" /></Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="DropDownToggle" Property="BorderBrush" Value="{DynamicResource EditorAccentBorder}" /><Setter TargetName="FocusRing" Property="Opacity" Value="0.28" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Background="{DynamicResource EditorWindowFill}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource EditorRibbonFill}" BorderBrush="{DynamicResource EditorDividerBrush}"
                BorderThickness="0,0,0,1" Padding="12,10">
            <WrapPanel x:Name="Toolbar" VerticalAlignment="Top">
                <Border BorderBrush="{DynamicResource EditorDividerBrush}" BorderThickness="0,0,1,0" Padding="0,0,12,0" Margin="0,0,12,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                            <Button x:Name="SelectToolButton" Style="{StaticResource InsertAction}" Click="OnSelectTool" ToolTip="选择并拖动标注；双击文字可直接修改" AutomationProperties.Name="选择和移动">
                                <StackPanel><Grid Height="24" Margin="0,0,0,5"><Path Data="M2,1 L2,18 L7,13 L11,21 L14,19 L10,12 L18,12 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeLineJoin="Round" Width="18" Height="22" Stretch="Uniform" /></Grid><TextBlock Text="选择" HorizontalAlignment="Center" /></StackPanel>
                            </Button>
                            <Button x:Name="TextToolButton" Style="{StaticResource InsertAction}" Click="OnTextTool" ToolTip="点击图片直接输入文字，Enter 换行，Esc 完成" AutomationProperties.Name="插入文字">
                                <StackPanel><Grid Height="24" Margin="0,0,0,5"><Path Data="M1,3 L19,3 M10,3 L10,21 M6,21 L14,21" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="20" Height="20" Stretch="Uniform" /></Grid><TextBlock Text="文字" HorizontalAlignment="Center" /></StackPanel>
                            </Button>
                            <Button x:Name="ArrowToolButton" Style="{StaticResource InsertAction}" Click="OnArrowTool" ToolTip="在图片上拖动绘制箭头" AutomationProperties.Name="插入箭头">
                                <StackPanel><Grid Height="24" Margin="0,0,0,5"><Path Data="M2,20 L20,2 M7,2 L20,2 L20,15" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="20" Height="20" Stretch="Uniform" /></Grid><TextBlock Text="箭头" HorizontalAlignment="Center" /></StackPanel>
                            </Button>
                            <Button x:Name="RectangleToolButton" Style="{StaticResource InsertAction}" Click="OnRectangleTool" ToolTip="在图片上拖动绘制矩形框" AutomationProperties.Name="插入矩形框">
                                <StackPanel><Grid Height="24" Margin="0,0,0,5"><Rectangle Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Width="22" Height="17" RadiusX="1" RadiusY="1" /></Grid><TextBlock Text="矩形" HorizontalAlignment="Center" /></StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="插入与选择" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <StackPanel Width="312">
                    <Grid Height="32" Margin="0,0,0,8">
                        <StackPanel x:Name="FontPropertiesGroup" Orientation="Horizontal">
                            <ComboBox x:Name="FontFamilyBox" Width="152" Margin="0,0,10,0" Style="{StaticResource FontSelectorStyle}"
                                      DisplayMemberPath="DisplayName" SelectedValuePath="FamilyName" IsEditable="False" SelectionChanged="OnFontFamilyChanged"
                                      AutomationProperties.Name="文字字体" ToolTip="字体：选择已安装的常用字体" />
                            <StackPanel x:Name="FontSizePanel" Orientation="Horizontal">
                                <Border x:Name="FontSizeStepper" Style="{StaticResource EditorStepper}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="28" /></Grid.ColumnDefinitions>
                                        <Button x:Name="DecreaseFontSizeButton" Grid.Column="0" Style="{StaticResource StepperButton}" Content="−" Click="OnDecreaseFontSize" ToolTip="缩小字号" AutomationProperties.Name="缩小字号" />
                                        <Border Grid.Column="1" BorderBrush="{DynamicResource EditorDividerBrush}" BorderThickness="1,0">
                                            <TextBox x:Name="FontSizeBox" Style="{StaticResource StepperInput}" Text="28" TextChanged="OnFontSizeChanged" LostKeyboardFocus="OnSizeLostFocus" ToolTip="字号：6–512 像素（按原图计算）" AutomationProperties.Name="字号" />
                                        </Border>
                                        <Button x:Name="IncreaseFontSizeButton" Grid.Column="2" Style="{StaticResource StepperButton}" Content="+" Click="OnIncreaseFontSize" ToolTip="增大字号" AutomationProperties.Name="增大字号" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel x:Name="ShapePropertiesGroup" Orientation="Horizontal" Visibility="Collapsed">
                            <StackPanel x:Name="ArrowThicknessPanel" Orientation="Horizontal">
                                <TextBlock Text="线条粗细" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <Border x:Name="ArrowThicknessStepper" Style="{StaticResource EditorStepper}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="28" /></Grid.ColumnDefinitions>
                                        <Button x:Name="DecreaseArrowThicknessButton" Grid.Column="0" Style="{StaticResource StepperButton}" Content="−" Click="OnDecreaseArrowThickness" ToolTip="减细线条" AutomationProperties.Name="减细线条" />
                                        <Border Grid.Column="1" BorderBrush="{DynamicResource EditorDividerBrush}" BorderThickness="1,0">
                                            <TextBox x:Name="ArrowThicknessBox" Style="{StaticResource StepperInput}" Text="4" TextChanged="OnArrowThicknessChanged" LostKeyboardFocus="OnSizeLostFocus" ToolTip="线条粗细：1–64 像素" AutomationProperties.Name="线条粗细" />
                                        </Border>
                                        <Button x:Name="IncreaseArrowThicknessButton" Grid.Column="2" Style="{StaticResource StepperButton}" Content="+" Click="OnIncreaseArrowThickness" ToolTip="加粗线条" AutomationProperties.Name="加粗线条" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                        <Button x:Name="ColorButton" Width="96" Style="{StaticResource EditorAction}" Padding="7,4" Click="OnPickColor" Margin="0,0,6,0" ToolTip="选择颜色">
                            <StackPanel Orientation="Horizontal"><Border x:Name="ColorSwatch" Width="16" Height="16" CornerRadius="3" BorderBrush="#80909090" BorderThickness="1" Margin="0,0,6,0" /><TextBlock x:Name="ColorLabel" Text="文字颜色" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                        <TextBox x:Name="ColorBox" Style="{StaticResource EditorInput}" Text="#E5484D" Width="92" MaxLength="7" Margin="0,0,8,0" TextChanged="OnColorTextChanged" LostKeyboardFocus="OnColorLostFocus" ToolTip="自定义颜色，例如 #FF6600" AutomationProperties.Name="标注颜色十六进制值" />
                        <Button x:Name="DeleteButton" Width="64" Style="{StaticResource EditorDangerAction}" Padding="6,4" Click="OnDeleteSelection" IsEnabled="False" ToolTip="删除选中的标注" AutomationProperties.Name="删除选中标注">
                            <StackPanel Orientation="Horizontal"><Path Data="M1,3 L11,3 M4,1 L8,1 M2,3 L3,13 L9,13 L10,3 M5,5 L5,10 M7,5 L7,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" StrokeLineJoin="Round" Width="12" Height="14" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" /><TextBlock Text="删除" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="PropertiesGroupTitle" Text="字体" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </WrapPanel>
        </Border>
        <Border Grid.Row="1" Margin="16" Background="{DynamicResource EditorWorkspaceFill}"
                BorderBrush="{DynamicResource EditorDividerBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
            <Grid x:Name="Viewport" Margin="12" SizeChanged="OnViewportSizeChanged">
                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border>
                        <Border.Background>
                            <DrawingBrush Viewport="0,0,16,16" ViewportUnits="Absolute" TileMode="Tile">
                                <DrawingBrush.Drawing>
                                    <DrawingGroup>
                                        <GeometryDrawing Brush="#FFF6F6F6" Geometry="M0,0 H16 V16 H0 Z" />
                                        <GeometryDrawing Brush="#FFE5E5E5" Geometry="M0,0 H8 V8 H0 Z M8,8 H16 V16 H8 Z" />
                                    </DrawingGroup>
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Border.Background>
                        <Grid Width="{Binding Width, ElementName=ImageCanvas}" Height="{Binding Height, ElementName=ImageCanvas}" ClipToBounds="True">
                        <controls:ImageAnnotationCanvas x:Name="ImageCanvas" MouseLeftButtonDown="OnImageMouseDown"
                            MouseMove="OnImageMouseMove" MouseLeave="OnImageMouseLeave" MouseLeftButtonUp="OnImageMouseUp" LostMouseCapture="OnImageLostCapture"
                            AutomationProperties.Name="图片标注画布" />
                        <Canvas x:Name="TextEditorLayer">
                            <Border x:Name="TextEditFrame" Visibility="Collapsed" Background="{DynamicResource EditorWindowFill}"
                                    BorderBrush="DodgerBlue" BorderThickness="1" Padding="4" MouseLeftButtonDown="OnTextFrameMouseDown">
                                <Grid>
                                    <TextBox x:Name="AnnotationTextBox" Style="{StaticResource InlineTextInput}" AcceptsReturn="True" AcceptsTab="False"
                                             TextWrapping="NoWrap" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                                             InputMethod.IsInputMethodEnabled="True" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale"
                                             TextChanged="OnAnnotationTextChanged" AutomationProperties.Name="图片上的文字输入框" />
                                    <TextBlock x:Name="InlinePlaceholder" Text="在此输入文字" Foreground="{DynamicResource TextSecondaryBrush}" IsHitTestVisible="False" />
                                </Grid>
                            </Border>
                        </Canvas>
                        </Grid>
                    </Border>
                </Viewbox>
            </Grid>
        </Border>
        <Border Grid.Row="2" BorderBrush="{DynamicResource EditorDividerBrush}" BorderThickness="0,1,0,0" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock x:Name="StatusText" Text="输入文字后点击图片放置；选择箭头工具后拖动绘制。"
                               FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock x:Name="ImageInfoText" FontSize="11" Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="CancelButton" Content="取消" Style="{StaticResource EditorAction}" MinWidth="68" Click="OnCancel" Margin="0,0,8,0" />
                    <Button x:Name="SaveButton" Content="保存并复制" Style="{StaticResource EditorPrimaryAction}" Click="OnSave" IsEnabled="False" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
