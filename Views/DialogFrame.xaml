<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
    <Border Background="{DynamicResource DialogSurfaceBrush}"
            BorderBrush="{DynamicResource GlassEdgeBrush}"
            BorderThickness="1"
            CornerRadius="18">
        <Border.Effect>
            <DropShadowEffect Color="{DynamicResource CardShadowColor}"
                              BlurRadius="24"
                              ShadowDepth="5"
                              Direction="270"
                              Opacity="0.24" />
        </Border.Effect>
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0"
                    Background="{DynamicResource DialogHeaderBrush}"
                    BorderBrush="{DynamicResource GlassEdgeBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="17,17,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal"
                                Margin="14,0,8,0"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <Image Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}}"
                               Width="18"
                               Height="18"
                               Margin="0,0,8,0"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Button x:Name="DialogCloseButton"
                            Grid.Column="1"
                            Style="{StaticResource DialogCloseButton}"
                            Margin="0,0,7,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="关闭"
                            AutomationProperties.Name="关闭">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8BB;" FontSize="10" />
                    </Button>
                </Grid>
            </Border>
            <ContentControl x:Name="DialogContent"
                            Grid.Row="1"
                            Foreground="{DynamicResource TextPrimaryBrush}" />
        </Grid>
    </Border>
</Grid>
