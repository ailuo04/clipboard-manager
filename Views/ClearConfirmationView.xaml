<Grid x:Class="ClipboardManager.Views.ClearConfirmationView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      AutomationProperties.Name="清空历史记录确认" Margin="0" TextElement.FontSize="12.5">
    <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Margin="16,8,16,12" VerticalAlignment="Center">
        <Border Width="36" Height="36" HorizontalAlignment="Center" CornerRadius="18"
                Background="{DynamicResource NoticeBackgroundBrush}" BorderBrush="{DynamicResource NoticeBorderBrush}"
                BorderThickness="1">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="16"
                       Foreground="{DynamicResource DangerTextBrush}" />
        </Border>
        <TextBlock Text="此操作无法撤销" FontSize="14" FontWeight="SemiBold"
                   HorizontalAlignment="Center" Margin="0,9,0,0" />
        <TextBlock x:Name="RecordSummaryText" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                   TextAlignment="Center" Margin="0,5,0,0" AutomationProperties.Name="将删除的记录数量" />
        <TextBlock Text="固定记录和已保存的图片也会一并删除。" Style="{StaticResource SecondaryText}"
                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,5,0,0" />
    </StackPanel>

    <Border Grid.Row="1" BorderBrush="{DynamicResource GlassEdgeBrush}" BorderThickness="0,1,0,0" Padding="12,9">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Button x:Name="CancelButton" Grid.Column="1" Content="取消" IsDefault="True" KeyboardNavigation.TabIndex="0"
                    MinWidth="68" MinHeight="30" Padding="10,4" Margin="0,0,8,0"
                    AutomationProperties.Name="取消清空历史记录" />
            <Button x:Name="ClearButton" Grid.Column="2" Content="清空" KeyboardNavigation.TabIndex="1" MinWidth="68" MinHeight="30" Padding="10,4"
                    Foreground="{DynamicResource DangerTextBrush}" Background="{DynamicResource SoftSurfaceBrush}"
                    BorderBrush="{DynamicResource GlassEdgeBrush}" AutomationProperties.Name="确认清空历史记录" />
        </Grid>
    </Border>
</Grid>
