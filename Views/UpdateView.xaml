<Grid x:Class="ClipboardManager.Views.UpdateView"
      AutomationProperties.Name="应用更新" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Margin="0">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Height="0" />

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20,24,8">
        <StackPanel>
            <Border Background="{DynamicResource SoftSurfaceBrush}" BorderBrush="{DynamicResource GlassStrokeBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="20,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="当前版本" Style="{StaticResource SecondaryText}" />
                        <TextBlock x:Name="CurrentVersionText" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="&#xE72A;" Style="{StaticResource Icon}" FontSize="16"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="16,10" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                        <TextBlock Text="最新版本" Style="{StaticResource SecondaryText}" HorizontalAlignment="Right" />
                        <TextBlock x:Name="LatestVersionText" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0"
                                   HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}" Text="—" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Background="{DynamicResource SoftSurfaceBrush}" BorderBrush="{DynamicResource GlassStrokeBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="20,18" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock x:Name="UpdateStatusText" Text="正在检查更新" FontSize="15" TextWrapping="Wrap" />
                    <TextBlock x:Name="UpdateDetailsText" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <ProgressBar x:Name="UpdateProgressBar" Height="4" Minimum="0" Maximum="100"
                                 Foreground="{DynamicResource AccentBrush}" Margin="0,16,0,0" Visibility="Collapsed" />
                    <Button x:Name="CancelDownloadButton" Style="{StaticResource IconButton}" ToolTip="取消下载"
                            AutomationProperties.Name="取消下载" HorizontalAlignment="Right" Margin="0,8,0,0" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" />
                    </Button>
                </StackPanel>
            </Border>

            <TextBlock Text="更新来源" Style="{StaticResource SecondaryText}" Margin="2,18,0,6" />
            <TextBlock Text="GitHub · ailuo04/clipboard-manager" TextWrapping="Wrap" />
            <TextBlock Text="只下载发生变化的文件，历史记录与设置保持不变。" Style="{StaticResource SecondaryText}"
                       TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Background="{DynamicResource StatusBarBrush}" BorderBrush="{DynamicResource GlassEdgeBrush}"
            BorderThickness="0,1,0,0" Padding="24,14">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CheckUpdateButton" Style="{StaticResource IconButton}" ToolTip="检查更新"
                    AutomationProperties.Name="检查更新" Margin="0,0,10,0">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" />
            </Button>
            <Button x:Name="InstallUpdateButton" Style="{StaticResource PrimaryButton}" IsEnabled="False" MinWidth="130">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE895;" Margin="0,0,8,0" />
                    <TextBlock Text="更新并重启" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</Grid>
