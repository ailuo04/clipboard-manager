<Grid x:Class="ClipboardManager.Views.UpdateView"
      AutomationProperties.Name="应用更新" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Margin="0" TextElement.FontSize="12.5">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Height="0" />

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18,6,18,0">
        <StackPanel HorizontalAlignment="Stretch">
            <Image Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}}" Width="44" Height="44"
                   HorizontalAlignment="Center" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Text="剪贴板" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0" />
            <TextBlock x:Name="CurrentVersionText" Style="{StaticResource SecondaryText}" FontSize="11.5"
                       HorizontalAlignment="Center" Margin="0,2,0,0" />

            <TextBlock x:Name="UpdateStatusText" Text="正在检查更新…" FontWeight="SemiBold" TextWrapping="Wrap"
                       TextAlignment="Center" HorizontalAlignment="Center" Margin="0,16,0,0" />
            <TextBlock x:Name="UpdateDetailsText" Style="{StaticResource SecondaryText}" FontSize="11.5" TextWrapping="Wrap"
                       TextAlignment="Center" HorizontalAlignment="Center" Margin="0,4,0,0" Visibility="Collapsed" />
            <ProgressBar x:Name="UpdateProgressBar" Height="3" Minimum="0" Maximum="100" BorderThickness="0"
                         Background="{DynamicResource CaptionDividerBrush}" Foreground="{DynamicResource AccentBrush}"
                         Margin="8,12,8,0" Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Padding="18,16,18,16">
        <Grid>
            <Button x:Name="CheckUpdateButton" Content="检查更新" MinHeight="30" Padding="10,5" />
            <Button x:Name="InstallUpdateButton" Content="立即更新" Style="{StaticResource PrimaryButton}" MinHeight="30" Padding="10,5"
                    IsEnabled="False" Visibility="Collapsed" />
            <Button x:Name="CancelDownloadButton" Content="取消" MinHeight="30" Padding="10,5" Visibility="Collapsed" />
        </Grid>
    </Border>
</Grid>
