<Grid x:Class="ClipboardManager.Views.UpdateView"
      AutomationProperties.Name="应用更新" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Margin="24">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Margin="0,0,0,20">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel>
            <TextBlock Text="应用更新" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="CurrentVersionText" Style="{StaticResource SecondaryText}" Margin="0,6,0,0" />
        </StackPanel>
        <Button x:Name="CheckUpdateButton" Grid.Column="1" Style="{StaticResource IconButton}" ToolTip="检查更新" AutomationProperties.Name="检查更新" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" />
        </Button>
        <Button x:Name="CloseUpdateButton" Grid.Column="2" Style="{StaticResource IconButton}" ToolTip="关闭应用更新" AutomationProperties.Name="关闭应用更新" IsCancel="True" Margin="8,0,0,0" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" />
        </Button>
    </Grid>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock x:Name="UpdateStatusText" Text="正在检查更新" FontSize="15" TextWrapping="Wrap" />
            <TextBlock x:Name="UpdateDetailsText" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,8,0,0" />
            <ProgressBar x:Name="UpdateProgressBar" Height="4" Minimum="0" Maximum="100" Foreground="{DynamicResource AccentBrush}" Margin="0,16,0,0" Visibility="Collapsed" />
            <Button x:Name="CancelDownloadButton" Style="{StaticResource IconButton}" ToolTip="取消下载" AutomationProperties.Name="取消下载" HorizontalAlignment="Right" Margin="0,8,0,0" Visibility="Collapsed">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" />
            </Button>
            <Separator Margin="0,22,0,16" />
            <TextBlock Text="发布源" Style="{StaticResource SecondaryText}" />
            <TextBlock Text="GitHub · ailuo04/clipboard-manager" TextWrapping="Wrap" Margin="0,6,0,0" />
            <TextBlock Text="读取最新正式版，只下载发生变化的文件。" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
        <Button x:Name="InstallUpdateButton" Style="{StaticResource PrimaryButton}" IsEnabled="False" MinWidth="120">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE895;" Margin="0,0,8,0" /><TextBlock Text="更新并重启" /></StackPanel>
        </Button>
    </StackPanel>
</Grid>
