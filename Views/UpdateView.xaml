<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Margin="24">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Margin="0,0,0,16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel>
            <TextBlock Text="应用更新" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="CurrentVersionText" Style="{StaticResource SecondaryText}" Margin="0,6,0,0" />
        </StackPanel>
        <Button x:Name="CheckUpdateButton" Grid.Column="1" Style="{StaticResource IconButton}" ToolTip="检查更新" AutomationProperties.Name="检查更新" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" />
        </Button>
    </Grid>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Border Background="{DynamicResource SoftSurfaceBrush}" BorderBrush="{DynamicResource GlassEdgeBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="12">
                <StackPanel>
                    <TextBlock x:Name="UpdateStatusText" Text="正在检查更新" FontSize="15" TextWrapping="Wrap" />
                    <TextBlock x:Name="UpdateDetailsText" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <ProgressBar x:Name="UpdateProgressBar" Height="4" Minimum="0" Maximum="100" Foreground="{DynamicResource AccentBrush}" Margin="0,16,0,0" Visibility="Collapsed" />
                    <Button x:Name="CancelDownloadButton" Style="{StaticResource IconButton}" ToolTip="取消下载" AutomationProperties.Name="取消下载" HorizontalAlignment="Right" Margin="0,8,0,0" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" />
                    </Button>
                </StackPanel>
            </Border>
            <Separator Margin="0,18,0,14" />
            <TextBlock Text="发布源" Style="{StaticResource SecondaryText}" />
            <TextBlock Text="GitHub · ailuo04/clipboard-manager" TextWrapping="Wrap" Margin="0,6,0,0" />
            <Border Background="{DynamicResource SoftSurfaceBrush}" BorderBrush="{DynamicResource GlassEdgeBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="10" Margin="0,16,0,0">
                <Expander Header="私有仓库访问" Background="Transparent" BorderThickness="0">
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="GitHub 只读访问令牌" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <PasswordBox x:Name="UpdateTokenBox" MaxLength="255" Padding="10,8" VerticalContentAlignment="Center"
                                         Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource GlassEdgeBrush}"
                                         AutomationProperties.Name="GitHub 只读访问令牌" />
                            <Button x:Name="SaveUpdateTokenButton" Grid.Column="1" Style="{StaticResource IconButton}" ToolTip="保存到 Windows 凭据管理器" AutomationProperties.Name="保存访问令牌" Margin="8,0,0,0">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" />
                            </Button>
                            <Button x:Name="DeleteUpdateTokenButton" Grid.Column="2" Style="{StaticResource IconButton}" ToolTip="删除已保存的访问令牌" AutomationProperties.Name="删除访问令牌" Margin="6,0,0,0">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" />
                            </Button>
                        </Grid>
                        <TextBlock x:Name="UpdateCredentialText" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Expander>
            </Border>
        </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Background="{DynamicResource SoftSurfaceBrush}" BorderBrush="{DynamicResource GlassEdgeBrush}"
            BorderThickness="1" CornerRadius="14" Padding="10" Margin="0,12,0,0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CloseUpdateButton" Content="关闭" IsCancel="True" MinWidth="84" Margin="0,0,10,0" />
            <Button x:Name="InstallUpdateButton" Style="{StaticResource PrimaryButton}" IsEnabled="False" MinWidth="120">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE895;" Margin="0,0,8,0" /><TextBlock Text="更新并重启" /></StackPanel>
            </Button>
        </StackPanel>
    </Border>
</Grid>
