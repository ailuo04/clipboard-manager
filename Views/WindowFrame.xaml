<Grid x:Class="ClipboardManager.Views.WindowFrame"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
      Background="{DynamicResource WindowBackgroundBrush}">

    <Grid x:Name="MainSurface">
        <Grid x:Name="WindowContent" Background="Transparent" />
    </Grid>
    <Grid x:Name="OverlayLayer" Visibility="Collapsed" Panel.ZIndex="10" shell:WindowChrome.IsHitTestVisibleInChrome="True"
          Background="{DynamicResource OverlayScrimBrush}"
          KeyboardNavigation.TabNavigation="Cycle" FocusManager.IsFocusScope="True">
        <Border Width="{Binding ActualWidth, ElementName=OverlayPanel}" Height="{Binding ActualHeight, ElementName=OverlayPanel}"
                HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8" CornerRadius="14"
                Background="{DynamicResource OverlayGlassBrush}" Effect="{DynamicResource OverlayShadowEffect}" IsHitTestVisible="False" />
        <Border x:Name="OverlayPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                Margin="8" Padding="0"
                Background="{DynamicResource OverlayGlassBrush}"
                BorderBrush="{DynamicResource OverlayEdgeBrush}" BorderThickness="1"
                CornerRadius="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- Every page gets its title and its way out here, inside the card. -->
                <Grid x:Name="PageHeader" Height="36">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BackButton" Style="{StaticResource CaptionButton}" Width="26" Height="26" MinHeight="26"
                            Margin="6,0,-6,0" Visibility="Collapsed" Click="OnBackClick"
                            ToolTip="返回" AutomationProperties.Name="返回">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72B;" FontSize="11" />
                    </Button>
                    <TextBlock x:Name="PageTitle" Grid.Column="1" Margin="12,0,0,0" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <Button x:Name="ClosePageButton" Grid.Column="2" Style="{StaticResource CaptionButton}" Width="26" Height="26" MinHeight="26"
                            Margin="0,0,6,0" Click="OnBackClick"
                            ToolTip="关闭" AutomationProperties.Name="关闭">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8BB;" FontSize="10" />
                    </Button>
                </Grid>
                <ContentControl x:Name="OverlayContent" Grid.Row="1" KeyboardNavigation.TabNavigation="Cycle" />
            </Grid>
        </Border>
    </Grid>
</Grid>
