<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ClipboardManager</RootNamespace>
    <AssemblyName>ClipboardManager</AssemblyName>
    <Version>0.0.16</Version>
    <Product>ClipboardManager</Product>
    <Description>Windows clipboard history manager with text, images, search, and pinning.</Description>
    <ApplicationIcon>Assets\Clipboard.ico</ApplicationIcon>
    <LangVersion>latest</LangVersion>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="UpdateHelper\**\*.cs" />
    <Compile Remove="Tests/**/*.cs" />
    <Using Include="System.IO" />
    <EmbeddedResource Include="Assets\Clipboard.ico" />
    <ApplicationDefinition Include="App.xaml" />
  </ItemGroup>
  <ItemGroup>
    <Page Include="Views\SharedResources.xaml" />
    <Page Include="Views\WindowFrame.xaml" />
    <Page Include="Views\MainView.xaml" />
    <Page Include="Views\SettingsView.xaml" />
    <Page Include="Views\ClearConfirmationView.xaml" />
    <Page Include="Views\UpdateView.xaml" />
    <Page Include="Views\ImageEditorWindow.xaml" />
    <Page Include="Views\LightGlass.xaml" />
    <Page Include="Views\LiquidGlass.xaml" />
  </ItemGroup>
</Project>
