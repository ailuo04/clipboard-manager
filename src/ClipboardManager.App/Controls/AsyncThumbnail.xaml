<UserControl
    x:Class="ClipboardManager.App.Controls.AsyncThumbnail"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.Name="图片缩略图">
    <Grid Background="{ThemeResource SurfaceBackgroundBrush}">
        <Image x:Name="ThumbnailImage" Stretch="UniformToFill" />
        <StackPanel x:Name="Placeholder" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4"
                    Visibility="Collapsed">
            <SymbolIcon Symbol="Pictures" Foreground="{ThemeResource SecondaryTextBrush}" />
            <TextBlock Text="预览不可用" FontSize="11" Foreground="{ThemeResource SecondaryTextBrush}" />
        </StackPanel>
    </Grid>
</UserControl>