<Page
    x:Class="ClipboardManager.App.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:AutomationProperties="using:Microsoft.UI.Xaml.Automation"
    Background="{ThemeResource PageBackgroundBrush}">
    <Grid x:Name="PageGrid" Padding="32,28,32,32" ColumnSpacing="24"
          AutomationProperties.Name="页面内容">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="DetailsColumn" Width="280" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,0,24">
            <TextBlock x:Name="SectionTitle" Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                       Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Text="{x:Bind ViewModel.Description, Mode=OneWay}"
                       Style="{StaticResource SectionDescriptionTextStyle}" />
        </StackPanel>

        <Border Grid.Row="1" Grid.Column="0" Padding="36" CornerRadius="16"
                Background="{ThemeResource CardBackgroundBrush}"
                BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1"
                AutomationProperties.Name="空状态说明">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460" Spacing="14">
                <Border Width="56" Height="56" CornerRadius="18" Background="{ThemeResource PageBackgroundBrush}"
                        HorizontalAlignment="Center" AutomationProperties.Name="剪贴板内容图标">
                    <SymbolIcon x:Name="EmptyStateIcon" Symbol="Copy" Foreground="{ThemeResource AccentBrush}"
                                Width="24" Height="24" />
                </Border>
                <TextBlock Text="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}" FontSize="20" FontWeight="SemiBold"
                           TextAlignment="Center" Foreground="{ThemeResource PrimaryTextBrush}" />
                <TextBlock Text="{x:Bind ViewModel.EmptyDescription, Mode=OneWay}"
                           Style="{StaticResource SectionDescriptionTextStyle}" TextAlignment="Center" />
            </StackPanel>
        </Border>

        <Border x:Name="DetailsSidebar" Grid.Column="1" Grid.RowSpan="2" Padding="22"
                CornerRadius="16" Background="{ThemeResource SurfaceBackgroundBrush}"
                BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1"
                AutomationProperties.Name="使用提示侧栏">
            <StackPanel Spacing="16">
                <StackPanel Spacing="6">
                    <TextBlock Text="使用提示" FontSize="15" FontWeight="SemiBold"
                               Foreground="{ThemeResource PrimaryTextBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.Hint, Mode=OneWay}"
                               Style="{StaticResource SectionDescriptionTextStyle}" />
                </StackPanel>
                <Rectangle Height="1" Fill="{ThemeResource CardStrokeBrush}" />
                <StackPanel Spacing="8">
                    <TextBlock Text="快速导航" FontSize="13" FontWeight="SemiBold"
                               Foreground="{ThemeResource PrimaryTextBrush}" />
                    <TextBlock Text="历史 · 搜索与回看" Style="{StaticResource SectionDescriptionTextStyle}" />
                    <TextBlock Text="收藏 · 保存常用内容" Style="{StaticResource SectionDescriptionTextStyle}" />
                    <TextBlock Text="更新中心 · 查看版本状态" Style="{StaticResource SectionDescriptionTextStyle}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>